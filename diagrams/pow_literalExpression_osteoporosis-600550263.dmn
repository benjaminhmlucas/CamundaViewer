<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/dmn" xmlns:biodi="http://bpmn.io/schema/dmn/biodi/2.0" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="Definitions_0sg2wct" name="DRD" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.27.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.21.0">
  <decision id="pow-diseases" name="POW Conditions">
    <informationRequirement id="InformationRequirement_1w6z12y">
      <requiredDecision href="#pow_literalExpression_all" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0ox2d9a">
      <requiredDecision href="#pow_literalExpression_osteoporosis" />
    </informationRequirement>
    <decisionTable id="DecisionTable_1xkygoz" hitPolicy="FIRST">
      <input id="Input_1" label="Has POW Rating Special Issue">
        <inputExpression id="InputExpression_1" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getRatingSpecialIssues() != null &amp;&amp; 
      !intake_pactPresumptiveCriteria.getRatingSpecialIssues().isEmpty() &amp;&amp; 
      intake_pactPresumptiveCriteria.getRatingSpecialIssues().any{ 'POW'.equalsIgnoreCase(it.spisTc)}</text>
        </inputExpression>
      </input>
      <input id="InputClause_0lvvwz4" label="POW Days">
        <inputExpression id="LiteralExpression_037u0d3" typeRef="integer" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.numberOfDaysPOW</text>
        </inputExpression>
      </input>
      <input id="InputClause_07rruo2" label="Claim Effective Date">
        <inputExpression id="LiteralExpression_0rhmsqz" typeRef="date" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.claimReceivedDate?.atStartOfDay()</text>
        </inputExpression>
      </input>
      <input id="InputClause_0psts8h" label="Osteoporosis COD Match" camunda:inputVariable="osteoporosisCodMatch">
        <inputExpression id="LiteralExpression_0gmkzbf" typeRef="boolean" expressionLanguage="groovy">
          <text>osteoporosisCodMatch</text>
        </inputExpression>
      </input>
      <input id="InputClause_0aml2zk" label="Other POW COD Match" biodi:width="192" camunda:inputVariable="powCondition">
        <inputExpression id="LiteralExpression_0vcisvr" typeRef="boolean" expressionLanguage="groovy">
          <text>powCondition != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_19p6zwj" label="Has PTSD Rated Disability">
        <inputExpression id="LiteralExpression_1akim1z" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.ratedDisabilities.any{ it.diagnosticCode == 9411 }</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="POW Result" name="powResult" typeRef="string" />
      <output id="OutputClause_1a5jw2f" label="Matched Condition" name="matchedPowCondition" typeRef="string" />
      <rule id="DecisionRule_0u2zosm">
        <description>POW - Osteoporosis and PTSD claimed after 10/10/2008</description>
        <inputEntry id="UnaryTests_1uqs0tu">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1u63x1y">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0uo3dqm">
          <text>&gt;= date and time("2008-10-10T00:00:00")</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0uvvjrd">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1b3khby">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_0wo0kgg">
          <text>true</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0niijl5">
          <text>"POW"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1inwk62">
          <text>"ptsd osteoporosis"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0uvh6uw">
        <description>POW - Osteoporosis and at least 30 days POW claimed after 09/28/2009</description>
        <inputEntry id="UnaryTests_0c75642">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1czgqpx">
          <text>&gt;= 30</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0eenvdq">
          <text>&gt;= date and time("2009-09-28")</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1b4uyq5">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0n6naz1">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_0flvji0">
          <text>false</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1g31mby">
          <text>"POW"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1vv2bh1">
          <text>"osteoporosis"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1lxxgay">
        <description>POW - Disability with 30 day POW minimum requirement</description>
        <inputEntry id="UnaryTests_0ybkn69">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1xsqhb6">
          <text>&gt;= 30</text>
        </inputEntry>
        <inputEntry id="UnaryTests_102pyju">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_14x4veu">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_0q9odyu">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_14bckow">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1ma20sy">
          <text>"POW"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1cne5n6">
          <text>powCondition</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1egfqdw">
        <description>POW - Disability without POW duration requirement</description>
        <inputEntry id="UnaryTests_0rtrk3d">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_07gkv6s">
          <text>&gt; 0</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0uxj9u2">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_1ghhpkc">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_0qpt8v3">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0uqlcrx">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1kj69lc">
          <text>"POW"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1hjhxuw">
          <text>powCondition</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1ya6qir">
        <inputEntry id="UnaryTests_1z050kg">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0kfgdv4">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_10g6san">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_18w703p">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_152skne">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_10j6ak3">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0nwdau8">
          <text>"POW_OFF_RAMP"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1rsctau">
          <text></text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0alt6c4">
        <inputEntry id="UnaryTests_04jhteg">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_1ef7ssk">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_045w2bc">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_0wi3ns9">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_0049fkh">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_18vqbh8">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0n54e4k">
          <text>"NO_POW"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0za904t">
          <text></text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="pow_literalExpression_all" name="POW Diseases">
    <variable id="InformationItem_02aw2hs" name="powCondition" typeRef="string" />
    <literalExpression id="LiteralExpression_1ohsfsv" expressionLanguage="groovy">
      <text>powCODSFor30Days = [
  "avitaminosis",
  "beriberi",
  "cirrhosis",
  "dysentery",
  "helminthiasis",
  "ibs",
  "irritable bowel syndrome",
  "malnutrition",
  "pellagra",
  "peripheral neuropathy"
]
powCODSForAny = [
  "anxiety",
  "dysthymic disorder",
  "frostbite",
  "hypertensive vascular disease",
  "neuropsychiatric",
  "post traumatic osteoarthritis",
  "psychosis",
  "pt osteoarthritis",
  "stroke"
]

powCondition = powCODSForAny.find{
  condition -&gt; intake_pactPresumptiveCriteria.causesOfDeathFromDeathCert.any{
    cause_of_death -&gt; cause_of_death.matches(".*\\b$condition\\b.*")
  }
}

if (powCondition == null &amp;&amp; intake_pactPresumptiveCriteria.numberOfDaysPOW &gt;= 30) {
    powCondition = powCODSFor30Days.find{
        condition -&gt; intake_pactPresumptiveCriteria.causesOfDeathFromDeathCert.any{cause_of_death -&gt; cause_of_death.matches(".*\\b$condition\\b.*")}
    }
}

powCondition</text>
    </literalExpression>
  </decision>
  <decision id="pow_literalExpression_osteoporosis" name="Osteoporosis DiseaseÂ ">
    <variable id="InformationItem_0wsgzhi" name="osteoporosisCodMatch" typeRef="boolean" />
    <literalExpression id="LiteralExpression_1q3w1g7" expressionLanguage="groovy">
      <text>osteoporosisConditions = ["osteoporosis"]

osteoporosisCodMatch = osteoporosisConditions.any{ 
    condition -&gt; intake_pactPresumptiveCriteria.causesOfDeathFromDeathCert.any{
        cause_of_death -&gt; cause_of_death.matches(".*\\b$condition\\b.*")
    } 
}</text>
    </literalExpression>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
      <dmndi:DMNShape dmnElementRef="pow-diseases">
        <dc:Bounds height="80" width="180" x="440" y="240" />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="DMNEdge_0gx1unq" dmnElementRef="InformationRequirement_1w6z12y">
        <di:waypoint x="530" y="160" />
        <di:waypoint x="530" y="220" />
        <di:waypoint x="530" y="240" />
      </dmndi:DMNEdge>
      <dmndi:DMNShape id="DMNShape_1rduong" dmnElementRef="pow_literalExpression_all">
        <dc:Bounds height="80" width="180" x="440" y="80" />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="DMNEdge_1xsxwy1" dmnElementRef="InformationRequirement_0ox2d9a">
        <di:waypoint x="340" y="280" />
        <di:waypoint x="420" y="280" />
        <di:waypoint x="440" y="280" />
      </dmndi:DMNEdge>
      <dmndi:DMNShape id="DMNShape_0wxb48j" dmnElementRef="pow_literalExpression_osteoporosis">
        <dc:Bounds height="80" width="180" x="160" y="240" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>

