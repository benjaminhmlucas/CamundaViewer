<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:biodi="http://bpmn.io/schema/dmn/biodi/2.0" xmlns:camunda="http://camunda.org/schema/1.0/dmn" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="ao_conditions" name="DRD" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.27.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.18.0">
  <decision id="herbicide-presumptive-pact" name="Herbicide Exposure">
    <informationRequirement id="InformationRequirement_0fy52ge">
      <requiredDecision href="#ao_conditions_original" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_1kd11ze">
      <requiredDecision href="#ao_conditions_20210101" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_1aqetal">
      <requiredDecision href="#ao_conditions_pact" />
    </informationRequirement>
    <decisionTable id="DecisionTable_1oh8bas" hitPolicy="COLLECT" biodi:annotationsWidth="454">
      <input id="InputClause_0i5zvp0" label="Benefit Type">
        <inputExpression id="LiteralExpression_0f9yuvv" typeRef="string" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getBenefitType()</text>
        </inputExpression>
      </input>
      <input id="InputClause_036dlrv" label="Claim Lifecycle Status">
        <inputExpression id="LiteralExpression_1mjf7c4" typeRef="string" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getClaimLifecycleStatus()</text>
        </inputExpression>
      </input>
      <input id="InputClause_0ft343f" label="Claim Lifecycle Phase">
        <inputExpression id="LiteralExpression_1wssp97" typeRef="string" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getClaimLifecycle()</text>
        </inputExpression>
      </input>
      <input id="InputClause_14y8tei" label="Veteran DOD">
        <inputExpression id="LiteralExpression_0qde56m" typeRef="date" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.dateOfDeath.atStartOfDay()</text>
        </inputExpression>
      </input>
      <input id="InputClause_1g7dijr" label="Claim within 1 year of Death" biodi:width="192">
        <inputExpression id="LiteralExpression_1fpcce7" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.claimWithin1YearOfDeath</text>
        </inputExpression>
      </input>
      <input id="InputClause_1dvw5kw" label="Valid ITF within 1 year of Death" biodi:width="192">
        <inputExpression id="LiteralExpression_14nlp14" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.itfWithin1YearOfDeath</text>
        </inputExpression>
      </input>
      <input id="InputClause_1kbc2fu" label="Valid ITF Date">
        <inputExpression id="LiteralExpression_0jif31b" typeRef="date" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.itfDate?.atStartOfDay()</text>
        </inputExpression>
      </input>
      <input id="InputClause_0rcsk6f" label="Last Service Era">
        <inputExpression id="LiteralExpression_01w7s0o" typeRef="string" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getLastServiceEra()</text>
        </inputExpression>
      </input>
      <input id="InputClause_1dzqxo3" label="AO Original COD Match" camunda:inputVariable="herbicideCondition">
        <inputExpression id="LiteralExpression_1a6370z" typeRef="boolean" expressionLanguage="groovy">
          <text>herbicideCondition != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_0xkmy1g" label="AO COD Effective 1/01/21 Match" camunda:inputVariable="aoCODS_01_01_21">
        <inputExpression id="LiteralExpression_1kj0yaf" typeRef="boolean" expressionLanguage="groovy">
          <text>aoCODS_01_01_21[0] != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_0dho36s" label="Has Any SC Disability Matching AO COD Effective 1/01/21" camunda:inputVariable="aoCODS_01_01_21">
        <inputExpression id="LiteralExpression_13gvujm" typeRef="boolean" expressionLanguage="groovy">
          <text>aoCODS_01_01_21[1] != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_17sf5rl" label="Latest SC Disability Matching Herbicide COD Effective 1/01/21" biodi:width="192" camunda:inputVariable="aoCODS_01_01_21">
        <inputExpression id="LiteralExpression_1p4xwcj" typeRef="boolean" expressionLanguage="groovy">
          <text>aoCODS_01_01_21[2] != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_0ho983y" label="Herbicide COD Effective 8/10/22 Match (PACT)" camunda:inputVariable="ao_aug10_2022">
        <inputExpression id="LiteralExpression_09dovb2" typeRef="boolean" expressionLanguage="groovy">
          <text>ao_aug10_2022 != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_05rv5lf" label="Has Herbicide Rating Special Issue" biodi:width="192">
        <inputExpression id="LiteralExpression_074lttp" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getRatingSpecialIssues() != null &amp;&amp; 
                !intake_pactPresumptiveCriteria.getRatingSpecialIssues().isEmpty() &amp;&amp; 
                intake_pactPresumptiveCriteria.getRatingSpecialIssues().any{ 'AO'.equalsIgnoreCase(it.spisTc)} ||
                intake_pactPresumptiveCriteria.getRatingSpecialIssues().any{ 'AOOV'.equalsIgnoreCase(it.spisTc)} ||
                intake_pactPresumptiveCriteria.getRatingSpecialIssues().any{ 'AOIV'.equalsIgnoreCase(it.spisTc)}
            </text>
        </inputExpression>
      </input>
      <input id="InputClause_1aohy8r" label="Has Herbicide Death Special Issue with Herbicide Basis">
        <inputExpression id="LiteralExpression_02ctyxp" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.hasAODeathSpecialIssueWithBasis</text>
        </inputExpression>
      </input>
      <input id="InputClause_0nzuee5" label="Has Herbicide Death Special Issue from Jan 1, 2021">
        <inputExpression id="LiteralExpression_0xuwnpl" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getDeathSpecialIssues() != null &amp;&amp; 
              !intake_pactPresumptiveCriteria.getDeathSpecialIssues().isEmpty() &amp;&amp; 
              intake_pactPresumptiveCriteria.getDeathSpecialIssues().any{ 'AOIV'.equalsIgnoreCase(it)} || 
              intake_pactPresumptiveCriteria.getDeathSpecialIssues().any{ 'AOOV'.equalsIgnoreCase(it)}
          </text>
        </inputExpression>
      </input>
      <input id="InputClause_14s7sbo" label="Herbicide Death Contention Special Issue">
        <inputExpression id="LiteralExpression_1ugottv" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getContentionSpecialIssues() != null &amp;&amp;
!intake_pactPresumptiveCriteria.getContentionSpecialIssues().isEmpty() &amp;&amp;
intake_pactPresumptiveCriteria.getContentionSpecialIssues().any{ 'BWAO'.equalsIgnoreCase(it)} ||
intake_pactPresumptiveCriteria.getContentionSpecialIssues().any{ 'NP'.equalsIgnoreCase(it)} ||
intake_pactPresumptiveCriteria.getContentionSpecialIssues().any{ 'NAPN'.equalsIgnoreCase(it)} ||
intake_pactPresumptiveCriteria.getContentionSpecialIssues().any{ 'NNAPN'.equalsIgnoreCase(it)} ||
intake_pactPresumptiveCriteria.getContentionSpecialIssues().any{ 'NNPN'.equalsIgnoreCase(it)}
            </text>
        </inputExpression>
      </input>
      <input id="InputClause_09vuzr5" label="Has Grantable Herbicide Corporate Flash">
        <inputExpression id="LiteralExpression_1p4t99u" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getCorporateFlashes() != null &amp;&amp;
              !intake_pactPresumptiveCriteria.getCorporateFlashes().isEmpty() &amp;&amp;
              intake_pactPresumptiveCriteria.getCorporateFlashes().any{'Agent Orange - Vietnam'.equalsIgnoreCase(it)} ||
              intake_pactPresumptiveCriteria.getCorporateFlashes().any{'Agent Orange Exposure Verified'.equalsIgnoreCase(it)} ||
              intake_pactPresumptiveCriteria.getCorporateFlashes().any{'Non - Nehmer Agent Orange 2010'.equalsIgnoreCase(it)} ||
              intake_pactPresumptiveCriteria.getCorporateFlashes().any{'Vietnam In - Country Service Verified'.equalsIgnoreCase(it)}
          </text>
        </inputExpression>
      </input>
      <input id="InputClause_1envsbb" label="Has Herbicide Corporate Flash Needing Review">
        <inputExpression id="LiteralExpression_0hu97t3" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getCorporateFlashes() != null &amp;&amp;
                !intake_pactPresumptiveCriteria.getCorporateFlashes().isEmpty() &amp;&amp;
                intake_pactPresumptiveCriteria.getCorporateFlashes().any{'Agent Orange - Vietnam'.equalsIgnoreCase(it)} ||
                intake_pactPresumptiveCriteria.getCorporateFlashes().any{'Blue Water Navy'.equalsIgnoreCase(it)} ||
                intake_pactPresumptiveCriteria.getCorporateFlashes().any{'Non - Nehmer Agent Orange 2010'.equalsIgnoreCase(it)} ||
                intake_pactPresumptiveCriteria.getCorporateFlashes().any{'Non - Nehmer AO Peripheral Neuropathy'.equalsIgnoreCase(it)}
            </text>
        </inputExpression>
      </input>
      <input id="InputClause_0oyfe5w" label="Claiming Income and Assets">
        <inputExpression id="LiteralExpression_1mf9x1m" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.isIncomeAndAssetsAnswered()</text>
        </inputExpression>
      </input>
      <input id="InputClause_0uya360" label="FF VBMSD-192340 evaluateAgentOrangePresumptiveConditions">
        <inputExpression id="LiteralExpression_15f9c6n" typeRef="boolean" expressionLanguage="groovy">
          <text>evaluateAgentOrangePresumptiveConditions</text>
        </inputExpression>
      </input>
      <output id="OutputClause_0f8qdtt" label="Herbicide Exposure" name="herbicideExposureResult" typeRef="string" biodi:width="238" />
