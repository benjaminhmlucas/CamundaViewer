  <decision id="ao_conditions_original" name="Original Herbicide Conditions">
    <variable id="InformationItem_0tpn5zf" name="herbicideCondition" typeRef="string" />
    <literalExpression id="LiteralExpression_14taaov" expressionLanguage="groovy">
      <text>herbicideCODS = [
    "adult fibrosarcoma",
    "adult form fibrosarcoma",
    "adult onset diabetes",
    "al amyloidosis",
    "alveolar soft part sarcoma",
    "amyloid light chain amyloidosis",
    "angioendotheliomatosis proliferans systemisata",
    "angiosarcoma",
    "ascvd",
    "atherosclerotic cardiovascular disease",
    "b cell leukemia",
    "bladder cancer",
    "cad",
    "cancer of the bronchus",
    "cancer of the larynx",
    "cancer of the lung",
    "cancer of the trachea",
    "chronic lymphocytic leukemia",
    "clear cell sarcoma of tendons and aponeuroses",
    "congenital fibrosarcoma",
    "coronary artery disease",
    "coronary bypass surgery",
    "coronary spasm",
    "dermatofibrosarcoma protuberans",
    "diabetes mellitus ii",
    "diabetes type 2",
    "dmii",
    "ectomesenchymoma",
    "epithelioid leiomyosarcoma",
    "epithelioid sarcoma",
    "extraskeletal ewings sarcoma",
    "hairy cell leukemia",
    "hemangiosarcoma",
    "hodgkins disease",
    "hypertension",
    "hypothyroidism",
    "infantile fibrosarcoma",
    "ischemic heart disease",
    "laryngeal cancer",
    "leiomyosarcoma",
    "liposarcoma",
    "lung cancer",
    "lymphangiosarcoma",
    "malignant fibrous histiocytoma",
    "malignant ganglioneuroma",
    "malignant giant cell tumor of tendon sheath",
    "malignant glomus tumor",
    "malignant granular cell tumor",
    "malignant hemangiopericytoma",
    "malignant leiomyoblastoma",
    "malignant melanoma of soft parts",
    "malignant mesenchymoma",
    "malignant pigmented villonodular synovitis",
    "malignant schwannoma",
    "malignant synovioma",
    "malignant triton tumor",
    "mgus",
    "mi",
    "monoclonal gammopathy of undetermined significance ",
    "multiple myeloma",
    "myocardial infarction",
    "non hodgkins lymphoma",
    "parkinsonism",
    "parkinsons",
    "parkinsons disease",
    "post coronary bypass",
    "primary amyloidosis",
    "prinzmetals angina",
    "prostate cancer",
    "reactive angioendotheliomatosis",
    "respiratory cancer",
    "rhabdomyosarcoma",
    "soft tissue sarcoma",
    "stable angina",
    "synovial sarcoma",
    "systemic angioendotheliomatosis",
    "tracheal cancer",
    "type 2 diabetes",
    "type ii diabetes",
    "unstable angina"
]


herbicideCODS.sort{a,b -&gt; b.length() &lt;=&gt; a.length()}


herbicideCODS.find{condition -&gt;
    intake_pactPresumptiveCriteria.causesOfDeathFromDeathCert.any{
        cause_of_death -&gt;
        cause_of_death.toLowerCase().matches(".*\\b$condition\\b.*") &amp;&amp;
        !(cause_of_death.toLowerCase().matches(".*hypertensive atherosclerotic cardiovascular disease.*")
            || cause_of_death.toLowerCase().matches(".*hypertensive ascvd.*")
            || cause_of_death.toLowerCase().matches(".*hascvd.*")
        )
    }
}</text>
    </literalExpression>
  </decision>
  <decision id="ao_conditions_20210101" name="Jan 1, 2021 Herbicide COD Conditions">
    <variable id="InformationItem_11b417v" name="aoCODS_01_01_21" />
    <literalExpression id="LiteralExpression_08kc57u" expressionLanguage="groovy">
      <text>aoCod01Jan2021 = [
    "bladder cancer",
    "hypothyroidism",
    "parkinsonism"
]


causes_deathCert = intake_pactPresumptiveCriteria.getCausesOfDeathFromDeathCert()


conditionFoundInDeathCert = aoCod01Jan2021.find{
    condition -&gt; causes_deathCert.any{ cause_of_death -&gt; if(cause_of_death != null)
          {cause_of_death.toLowerCase().matches(".*\\b$condition\\b.*")}
    }
}


causes_rba = intake_pactPresumptiveCriteria.getCausesOfDeathFromRatingProfile()


conditionFoundInRatingProfile = aoCod01Jan2021.find{
    condition -&gt; causes_rba.any{ cause_of_death -&gt; if(cause_of_death != null)
          {cause_of_death.toLowerCase().matches(condition)}
    }
}


ratingDecision = intake_pactPresumptiveCriteria.latestRatingSCDeathDecision


conditionFoundInLatestRating = ratingDecision != null &amp;&amp; ratingDecision.getDgnstcTxt() != null ? 
    aoCod01Jan2021.find{condition -&gt; ratingDecision.getDgnstcTxt().toLowerCase().replaceAll(" ","").matches(condition.replaceAll(" ",""))} : null

aoCODS_01_01_21 = [conditionFoundInDeathCert, conditionFoundInRatingProfile, conditionFoundInLatestRating]</text>
    </literalExpression>
  </decision>
  <decision id="ao_conditions_pact" name="Herbicide Exposure - PACT Effective 8/10/2022">
    <variable id="InformationItem_1v68qbs" name="ao_aug10_2022" typeRef="string" />
    <literalExpression id="LiteralExpression_126ute1" expressionLanguage="groovy">
      <text>herbicideCODs = [
  "hypertension",
  "mgus", 
  "monoclonal gammopathy of undetermined significance"
]

causes_deathCert = intake_pactPresumptiveCriteria.getCausesOfDeathFromDeathCert()

ao_aug10_2022 = herbicideCODs.find{
    condition -&gt; causes_deathCert.any{
        cause_of_death -&gt; cause_of_death.matches(".*\\b$condition\\b.*")
    }
}</text>
    </literalExpression>
  </decision>
