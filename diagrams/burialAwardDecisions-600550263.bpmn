<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_020f3z1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="3.7.2">
  <bpmn:collaboration id="Collaboration_0a68zyl">
    <bpmn:participant id="activityForAddingBurialAwardDecisions" name="Burial Award Decisions" processRef="burialAwardDecisions" />
  </bpmn:collaboration>
  <bpmn:process id="burialAwardDecisions" name="SC Burial Decisions" isExecutable="true">
    <bpmn:exclusiveGateway id="burialAwardStatusCheck" name="Award Pending Authorization?" default="existingBurialAwardNotPendingAuthorization">
      <bpmn:incoming>flowFromCheckForExistingBurialDecnsToReadDateOfDeath</bpmn:incoming>
      <bpmn:outgoing>existingBurialAwardNotPendingAuthorization</bpmn:outgoing>
      <bpmn:outgoing>existingBurialAwardPendingAuthorization</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="checkExistingBurialDecisions" name="Check for Existing Burial Decisions" camunda:delegateExpression="${checkForExistingBurialDecisions}">
      <bpmn:incoming>checkCPLTerminated</bpmn:incoming>
      <bpmn:outgoing>flowFromCheckForExistingBurialDecnsToReadDateOfDeath</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="saveBurialDecisionsTask" name="Save Burial Decisions" camunda:delegateExpression="${burialDecisions}">
      <bpmn:incoming>existingBurialAwardNotPendingAuthorization</bpmn:incoming>
      <bpmn:outgoing>endBurialAwardDecisionsFlow</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="burialAwardDecisionsEnd" name="End Burial Award Decisions">
      <bpmn:incoming>endBurialAwardDecisionsFlow</bpmn:incoming>
      <bpmn:incoming>existingBurialAwardPendingAuthorization</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="burialAwardDecisionsStart" name="Start Burial Award Decisions">
      <bpmn:outgoing>checkCPLTerminated</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="endBurialAwardDecisionsFlow" sourceRef="saveBurialDecisionsTask" targetRef="burialAwardDecisionsEnd" />
    <bpmn:sequenceFlow id="existingBurialAwardPendingAuthorization" name="Yes" sourceRef="burialAwardStatusCheck" targetRef="burialAwardDecisionsEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${awards_currentAward.awardStatus eq "GENERATED" || awards_currentAward.awardStatus eq "PENDING_CONCUR"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="existingBurialAwardNotPendingAuthorization" name="No" sourceRef="burialAwardStatusCheck" targetRef="saveBurialDecisionsTask" />
    <bpmn:sequenceFlow id="flowFromCheckForExistingBurialDecnsToReadDateOfDeath" sourceRef="checkExistingBurialDecisions" targetRef="burialAwardStatusCheck" />
    <bpmn:sequenceFlow id="checkCPLTerminated" sourceRef="burialAwardDecisionsStart" targetRef="checkExistingBurialDecisions" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_0a68zyl">
      <bpmndi:BPMNShape id="Participant_15423b3_di" bpmnElement="activityForAddingBurialAwardDecisions" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="740" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1xkte7p_di" bpmnElement="endBurialAwardDecisionsFlow">
        <di:waypoint x="750" y="270" />
        <di:waypoint x="822" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1p1lvsh_di" bpmnElement="existingBurialAwardPendingAuthorization">
        <di:waypoint x="520" y="245" />
        <di:waypoint x="520" y="150" />
        <di:waypoint x="840" y="150" />
        <di:waypoint x="840" y="252" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="573" y="132" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1h9ircx_di" bpmnElement="existingBurialAwardNotPendingAuthorization">
        <di:waypoint x="545" y="270" />
        <di:waypoint x="650" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="591" y="252" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_00qsybo_di" bpmnElement="flowFromCheckForExistingBurialDecnsToReadDateOfDeath">
        <di:waypoint x="430" y="270" />
        <di:waypoint x="495" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0mu3b2n_di" bpmnElement="checkCPLTerminated">
        <di:waypoint x="248" y="270" />
        <di:waypoint x="330" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Gateway_01ww3ca_di" bpmnElement="burialAwardStatusCheck" isMarkerVisible="true">
        <dc:Bounds x="495" y="245" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="484" y="302" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1a6wlh5_di" bpmnElement="checkExistingBurialDecisions">
        <dc:Bounds x="330" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0hotoku_di" bpmnElement="saveBurialDecisionsTask">
        <dc:Bounds x="650" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_1av3bfz_di" bpmnElement="burialAwardDecisionsEnd">
        <dc:Bounds x="822" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="798" y="295" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_1kwxqw1_di" bpmnElement="burialAwardDecisionsStart">
        <dc:Bounds x="212" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="186" y="295" width="89" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

