<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_1hz5xkn" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.6.0">
  <bpmn:collaboration id="Collaboration_1ey8jao">
    <bpmn:participant id="eFolderUploadParticipant" name="eFolder Upload Process" processRef="eFolderUploadProcess" />
    <bpmn:participant id="pacmanParticipant" name="Pacman Process" processRef="pacmanProcess" />
    <bpmn:participant id="finalizationParticipant" name="Finalization Process" processRef="finalizationProcess" />
  </bpmn:collaboration>
  <bpmn:process id="eFolderUploadProcess" name="eFolder Upload Process" isExecutable="true" camunda:historyTimeToLive="15">
    <bpmn:startEvent id="eFolderUploadStart" name="Start eFolder Upload" camunda:asyncAfter="true">
      <bpmn:outgoing>Flow_1x2xgb9</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_072tml9" name="Fetch Documents to Upload" camunda:asyncBefore="true" camunda:delegateExpression="${fetchDocumentsToUploadDelegate}">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R2/PT10S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1x2xgb9</bpmn:incoming>
      <bpmn:outgoing>Flow_0u8if09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1rhou0d" name="Upload Document" camunda:asyncBefore="true" camunda:delegateExpression="${uploadDocumentDelegate}">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R2/PT10S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0u8if09</bpmn:incoming>
      <bpmn:outgoing>Flow_14wf3lt</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${uploadDocumentIds}" camunda:elementVariable="uploadDocumentId" />
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_1cez4zf" name="Upload Completed">
      <bpmn:incoming>Flow_14wf3lt</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0u8if09" sourceRef="Activity_072tml9" targetRef="Activity_1rhou0d" />
    <bpmn:sequenceFlow id="Flow_1x2xgb9" sourceRef="eFolderUploadStart" targetRef="Activity_072tml9" />
    <bpmn:sequenceFlow id="Flow_14wf3lt" sourceRef="Activity_1rhou0d" targetRef="Event_1cez4zf" />
  </bpmn:process>
  <bpmn:process id="pacmanProcess" name="Pacman Process" isExecutable="true" camunda:historyTimeToLive="15">
    <bpmn:serviceTask id="Activity_13e8c63" name="Send Notifications" camunda:asyncBefore="true" camunda:delegateExpression="${sendNotificationsDelegate}">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R2/PT10S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0bmeu18</bpmn:incoming>
      <bpmn:outgoing>Flow_1nje8cp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="pacmanStart" name="Start Pacman" camunda:asyncAfter="true">
      <bpmn:outgoing>Flow_0bmeu18</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_1hpw93c" name="Pacman Completed">
      <bpmn:incoming>Flow_1nje8cp</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0bmeu18" sourceRef="pacmanStart" targetRef="Activity_13e8c63" />
    <bpmn:sequenceFlow id="Flow_1nje8cp" sourceRef="Activity_13e8c63" targetRef="Event_1hpw93c" />
  </bpmn:process>
  <bpmn:process id="finalizationProcess" name="Finalization Process" isExecutable="true" camunda:historyTimeToLive="15">
    <bpmn:startEvent id="startFinalization" name="Finalization" camunda:asyncAfter="true">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#34;startMessage&#34;, &#34;StartFinalizationMessage&#34;)}" event="end" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1hyr2bn</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0gevlsu" messageRef="Message_1eassq8" />
    </bpmn:startEvent>
    <bpmn:startEvent id="startDocumentUpload" name="Upload Documents to eFolder" camunda:asyncAfter="true">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#34;startMessage&#34;, &#34;StartDocumentUploadMessage&#34;)}" event="end" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0ay0rej</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0wi52bo" messageRef="Message_0u1qht8" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1hyr2bn" sourceRef="startFinalization" targetRef="Activity_1lbnhpf" />
    <bpmn:sequenceFlow id="Flow_0ay0rej" sourceRef="startDocumentUpload" targetRef="callUploadDocumentStandalone" />
    <bpmn:sequenceFlow id="Flow_0jpng0p" sourceRef="startPacman" targetRef="callPacmanFromStandalone" />
    <bpmn:startEvent id="startPacman" name="Send Notification Documents" camunda:asyncAfter="true">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#34;startMessage&#34;, &#34;StartDocumentPacmanMessage&#34;)}" event="end" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0jpng0p</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_00s6lb6" messageRef="Message_046uc0p" />
    </bpmn:startEvent>
    <bpmn:callActivity id="callUploadDocumentFromFinalization" name="Upload Documents to eFolder" camunda:asyncAfter="true" calledElement="eFolderUploadProcess">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0fcdy6e</bpmn:incoming>
      <bpmn:outgoing>Flow_17lokf7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="callPacmanFromFinalization" name="Send Notification Documents" calledElement="pacmanProcess">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17lokf7</bpmn:incoming>
      <bpmn:outgoing>Flow_1pg3uqo</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="callUploadDocumentStandalone" name="Upload Documents to eFolder" calledElement="eFolderUploadProcess">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ay0rej</bpmn:incoming>
      <bpmn:outgoing>Flow_1sj401j</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="Event_19ekxx6" name="Complete and Resolve Any Incidents">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${resolveIncidentListener}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1pg3uqo</bpmn:incoming>
      <bpmn:incoming>Flow_1sj401j</bpmn:incoming>
      <bpmn:incoming>Flow_0adlmi7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="callPacmanFromStandalone" name="Send Notification Documents" calledElement="pacmanProcess">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0jpng0p</bpmn:incoming>
      <bpmn:outgoing>Flow_0adlmi7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:subProcess id="Activity_1suyo0o" name="Finalization Incident Handler" triggeredByEvent="true">
      <bpmn:startEvent id="Event_0czmvn6" name="Incident Captured" camunda:asyncAfter="true">
        <bpmn:extensionElements>
          <camunda:failedJobRetryTimeCycle>R1/PT0S</camunda:failedJobRetryTimeCycle>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_17uaqq5</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_11ce6oy" camunda:errorCodeVariable="errorCode" camunda:errorMessageVariable="errorMessage" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_17uaqq5" sourceRef="Event_0czmvn6" targetRef="Activity_12rec59" />
      <bpmn:serviceTask id="Activity_12rec59" name="Create Finalization Incident" camunda:asyncBefore="true" camunda:delegateExpression="${finalizeIncidentHandlerDelegate}">
        <bpmn:incoming>Flow_17uaqq5</bpmn:incoming>
        <bpmn:outgoing>Flow_12q43iz</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_12q43iz" sourceRef="Activity_12rec59" targetRef="Event_1jbk8e8" />
      <bpmn:endEvent id="Event_1jbk8e8" name="Resolved">
        <bpmn:incoming>Flow_12q43iz</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_17lokf7" sourceRef="callUploadDocumentFromFinalization" targetRef="callPacmanFromFinalization" />
    <bpmn:sequenceFlow id="Flow_1pg3uqo" sourceRef="callPacmanFromFinalization" targetRef="Event_19ekxx6" />
    <bpmn:sequenceFlow id="Flow_1sj401j" sourceRef="callUploadDocumentStandalone" targetRef="Event_19ekxx6" />
    <bpmn:sequenceFlow id="Flow_0adlmi7" sourceRef="callPacmanFromStandalone" targetRef="Event_19ekxx6" />
    <bpmn:serviceTask id="Activity_1lbnhpf" name="Narrative Letter Inclusion Decision" camunda:asyncBefore="true" camunda:delegateExpression="${narrativeLetterInclusionDecisionDelegate}">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R12/PT10S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1hyr2bn</bpmn:incoming>
      <bpmn:outgoing>Flow_0fcdy6e</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0fcdy6e" sourceRef="Activity_1lbnhpf" targetRef="callUploadDocumentFromFinalization" />
    <bpmn:textAnnotation id="TextAnnotation_0fhushv">
      <bpmn:text>Fetch the Narrative Letter from eFolder if already exists and is required to use in package. A call to eFolder would happen if this claim processing did not generate a Narrative Letter (RFA or reprocessing of claim that routed straight to Awards, skipping Ratings)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_052iqgy" sourceRef="Activity_1lbnhpf" targetRef="TextAnnotation_0fhushv" />
  </bpmn:process>
