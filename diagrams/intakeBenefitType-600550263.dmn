<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="intakeBenefitTypeDefinition" name="Intake Benefit Type Definition" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="4.12.0">
  <decision id="intakeBenefitType" name="intake Benefit Type">
    <decisionTable id="decisionTable_1" hitPolicy="FIRST">
      <input id="input_1" label="EP Code">
        <inputExpression id="inputExpression_1" typeRef="integer">
          <text>claimData.getEndProductCode()</text>
        </inputExpression>
      </input>
      <input id="InputClause_1hpsh9q" label="Claim from Auto Burial Intake">
        <inputExpression id="LiteralExpression_1jeqjfz" typeRef="boolean">
          <text>claimFromAutoBurialIntake != null and claimFromAutoBurialIntake</text>
        </inputExpression>
      </input>
      <input id="InputClause_15pua5q" label="Claim Label">
        <inputExpression id="LiteralExpression_0ceviik" typeRef="string" expressionLanguage="groovy">
          <text>claimData?.benefitClaimType?.code</text>
        </inputExpression>
      </input>
      <input id="InputClause_1jmhzt8" label="Does pending DIC claim exist when processing burial?">
        <inputExpression id="LiteralExpression_0bct8dd" typeRef="boolean" expressionLanguage="groovy">
          <text>if (eligibility_pendingDicClaimExists != null) {eligibility_pendingDicClaimExists}</text>
        </inputExpression>
      </input>
      <input id="InputClause_1o6rdyc" label="Claimant Relationship">
        <inputExpression id="LiteralExpression_1jaqzdt" typeRef="string" expressionLanguage="groovy">
          <text>claimantPersonalInfoData?.relationship?.name</text>
        </inputExpression>
      </input>
      <input id="InputClause_0rb5mha" label="Form 530 Block 13A">
        <inputExpression id="LiteralExpression_09qohkh" typeRef="string" expressionLanguage="groovy">
          <text>if(claimExecution.benefitsProcessingData != null &amp;&amp; claimExecution.benefitsProcessingData.form530GroupData != null &amp;&amp; claimExecution.benefitsProcessingData.form530GroupData.serviceConnectedDeath != null &amp;&amp; claimExecution.benefitsProcessingData.form530GroupData.serviceConnectedDeath) {"SC"} 
else if(claimExecution.benefitsProcessingData != null &amp;&amp; claimExecution.benefitsProcessingData.form530GroupData!= null &amp;&amp; claimExecution.benefitsProcessingData.form530GroupData.nonServiceConnectedDeath !=null &amp;&amp; claimExecution.benefitsProcessingData.form530GroupData.nonServiceConnectedDeath) {"NSC"}
else if(claimExecution.benefitsProcessingData != null &amp;&amp; claimExecution.benefitsProcessingData.form530GroupData!= null &amp;&amp; claimExecution.benefitsProcessingData.form530GroupData.vaMedicalCenterDeath != null &amp;&amp; claimExecution.benefitsProcessingData.form530GroupData.vaMedicalCenterDeath) {"VMCD"} 
else {null}</text>
        </inputExpression>
      </input>
      <output id="output_1" label="Benefit Type" name="intake_benefitType" typeRef="string" />
      <output id="OutputClause_1jxuo2t" label="Award Type" name="intake_awardType" typeRef="string" />
      <output id="OutputClause_1qoph7m" label="Error Code" name="intake_errorCode" typeRef="string" />
