  <decision id="presumptive-decisions-all" name="All Presumptive Decisions">
    <decisionTable id="DecisionTable_1jqb433" hitPolicy="RULE ORDER">
      <input id="InputClause_18zqudq" label="Attorney Fee">
        <inputExpression id="LiteralExpression_0udt7xd" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.corporateFlashes != null &amp;&amp; !intake_pactPresumptiveCriteria.corporateFlashes.isEmpty() &amp;&amp; (
    intake_pactPresumptiveCriteria.corporateFlashes.any{'Potential Attorney Fee'.equalsIgnoreCase(it)}
    || intake_pactPresumptiveCriteria.corporateFlashes.any{'Private Attorney - Fees Payable'.equalsIgnoreCase(it)}
    || intake_pactPresumptiveCriteria.corporateFlashes.any{'Private Attorney - No Fees Payable'.equalsIgnoreCase(it)}
)</text>
        </inputExpression>
      </input>
      <input id="InputClause_0ysm6vt" label="Pending Presumptive Claim">
        <inputExpression id="LiteralExpression_00626ik" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.hasPendingPresumptiveClaim</text>
        </inputExpression>
      </input>
      <input id="Input_1" label="Less Than 90 Days of Service">
        <inputExpression id="InputExpression_1" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.numberOfDaysServed &lt; 90 &amp;&amp;
                        !intake_pactPresumptiveCriteria.missingServiceDates</text>
        </inputExpression>
      </input>
      <input id="InputClause_0k9kud2" label="Herbicide Exposure" biodi:width="226">
        <inputExpression id="LiteralExpression_0n2fsq9" typeRef="string" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getHerbicideFinalDmnResult().get("herbicideExposureResult")</text>
        </inputExpression>
      </input>
      <input id="InputClause_0wxyile" label="Gulf War Exposure" biodi:width="190">
