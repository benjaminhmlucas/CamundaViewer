  <bpmn:collaboration id="intakeCollaboration">
    <bpmn:participant id="mainIntakeProcess" name="Pension Automation Intake Process" processRef="intakeProcess" />
    <bpmn:textAnnotation id="TextAnnotation_13kzafb">
      <bpmn:text>Start of Initial Development Process</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0kx62jl" sourceRef="callClassificationProcess" targetRef="TextAnnotation_13kzafb" />
  </bpmn:collaboration>
  <bpmn:process id="intakeProcess" name="Intake Process" isExecutable="true" camunda:versionTag="1.0.0" camunda:historyTimeToLive="15">
    <bpmn:sequenceFlow id="StartAc_RetClaim_Flow" sourceRef="startIntake" targetRef="Activity_LoadConfiguration" />
    <bpmn:sequenceFlow id="Flow_1f9r1lf" sourceRef="Activity_LoadConfiguration" targetRef="intakeClaimActivity" />
    <bpmn:sequenceFlow id="Flow_1uwa96c" sourceRef="intakeClaimActivity" targetRef="Activity_0zbqj9i" />
    <bpmn:startEvent id="startIntake" name="Start" camunda:asyncAfter="true">
      <bpmn:outgoing>StartAc_RetClaim_Flow</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_LoadConfiguration" name="Load Configuration" camunda:delegateExpression="${loadConfigurationDelegate}">
      <bpmn:incoming>StartAc_RetClaim_Flow</bpmn:incoming>
      <bpmn:incoming>Flow_0fpsmjb</bpmn:incoming>
      <bpmn:incoming>Flow_0fccixz</bpmn:incoming>
      <bpmn:outgoing>Flow_1f9r1lf</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="intakeClaimActivity" name="Intake Claim" camunda:delegateExpression="${intakeClaim}">
      <bpmn:incoming>Flow_1f9r1lf</bpmn:incoming>
      <bpmn:outgoing>Flow_1uwa96c</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="restartIntake" name="Restart Intake">
      <bpmn:outgoing>Flow_0fpsmjb</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1scyg7j" messageRef="Message_0t23b1a" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0fpsmjb" sourceRef="restartIntake" targetRef="Activity_LoadConfiguration" />
    <bpmn:sequenceFlow id="Flow_1e2q5gq" sourceRef="Activity_0gdmvd7" targetRef="RetrieveSupplementalData" />
    <bpmn:sequenceFlow id="Flow_0u5swdd" sourceRef="Activity_0zbqj9i" targetRef="Activity_0gdmvd7" />
    <bpmn:serviceTask id="Activity_0gdmvd7" name="Retrieve Benefits Processing Data" camunda:delegateExpression="${bpdsDelegate}">
      <bpmn:incoming>Flow_0u5swdd</bpmn:incoming>
      <bpmn:outgoing>Flow_1e2q5gq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0zbqj9i" name="Retrieve Veteran Info" camunda:delegateExpression="${veteranInfoDelegate}">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${veteranAdditionalIdentifiers}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1uwa96c</bpmn:incoming>
      <bpmn:outgoing>Flow_0u5swdd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1mzp0ug" name="Update Benefit Claim Type" camunda:delegateExpression="${updateBenefitClaimTypeDelegate}">
      <bpmn:incoming>Flow_1x5p7yx</bpmn:incoming>
      <bpmn:outgoing>Flow_1ueox1j</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0sp2pat" name="Eligible for Benefit Claim Type Change?" default="Flow_0monq2g">
      <bpmn:incoming>Flow_1pv1yol</bpmn:incoming>
      <bpmn:outgoing>Flow_0monq2g</bpmn:outgoing>
      <bpmn:outgoing>Flow_1x5p7yx</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_15h1ahz" default="intakeOfframpFlow">
      <bpmn:incoming>Flow_0o94d3j</bpmn:incoming>
      <bpmn:outgoing>intakeAwardFlow</bpmn:outgoing>
      <bpmn:outgoing>intakeOfframpFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="dicRatingMessageEvent" name="Call Rating Process">
      <bpmn:incoming>intakeRatingFlow</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0oktu7v" camunda:delegateExpression="${callRating}" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_1j5whsf" default="Flow_0o94d3j">
      <bpmn:incoming>Flow_1g0kamk</bpmn:incoming>
      <bpmn:outgoing>Flow_0o94d3j</bpmn:outgoing>
      <bpmn:outgoing>intakeRatingFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_1jgmpr9" name="Call Development Process">
      <bpmn:incoming>intakeDevelopmentFlow</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_15b58d8" camunda:delegateExpression="${callDevelopment}" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_0pug5cd" default="Flow_1g0kamk">
      <bpmn:incoming>Flow_1ocjvo1</bpmn:incoming>
      <bpmn:outgoing>Flow_1g0kamk</bpmn:outgoing>
      <bpmn:outgoing>intakeDevelopmentFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_1rgzyep" name="Benefit Claim Type Change Eligibility" camunda:delegateExpression="${benefitClaimTypeUpdateEligibilityDelegate}">
      <bpmn:incoming>SequenceFlow_1lhtdn1</bpmn:incoming>
      <bpmn:outgoing>Flow_1pv1yol</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="EvaluateSupplementalDataActivity" name="Evaluate Supplemental Data" camunda:resultVariable="evalSuppMap" camunda:decisionRef="intake-evaluate-supplemental" camunda:decisionRefBinding="deployment" camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>Flow_1b1fxwo</bpmn:incoming>
      <bpmn:outgoing>Flow_0ey6j66</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_13naasg" name="Supplemental Data Complete?">
      <bpmn:incoming>Flow_0ey6j66</bpmn:incoming>
      <bpmn:outgoing>Flow_13ltsoa</bpmn:outgoing>
      <bpmn:outgoing>benefitTypeFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_1nplsfb" name="Missing Data to Automate">
      <bpmn:incoming>Flow_13ltsoa</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_03j9mlk" errorRef="Error_1vv4qi0" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_16iensl" name="Preliminary Rating" camunda:delegateExpression="${preliminaryRating}">
      <bpmn:incoming>Flow_1ka6nn7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1lhtdn1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="callInitialDevelopment" name="Eligibility and Entitlement" calledElement="eligibilityProcess">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0monq2g</bpmn:incoming>
      <bpmn:outgoing>burialEligibilityEndFlow</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="routingDecisionGateway" name="Routing Decision">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${iDevEndListener}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>burialEligibilityEndFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_1ocjvo1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_11vzdrr" name="Restart Intake Process">
      <bpmn:incoming>Flow_1ueox1j</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0jqi41r" camunda:delegateExpression="${restartIntake}" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="RetrieveSupplementalData" name="Retrieve Supplemental Data" camunda:delegateExpression="${supplementalDelegate}">
      <bpmn:incoming>Flow_1e2q5gq</bpmn:incoming>
      <bpmn:outgoing>Flow_1b1fxwo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1x5p7yx" name="Yes" sourceRef="Gateway_0sp2pat" targetRef="Activity_1mzp0ug">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${eligibility_updateBenefitClaimTypeReason != "INELIGIBLE"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ueox1j" sourceRef="Activity_1mzp0ug" targetRef="Event_11vzdrr" />
    <bpmn:sequenceFlow id="Flow_1pv1yol" sourceRef="Activity_1rgzyep" targetRef="Gateway_0sp2pat" />
    <bpmn:sequenceFlow id="Flow_0monq2g" name="No" sourceRef="Gateway_0sp2pat" targetRef="callInitialDevelopment" />
    <bpmn:sequenceFlow id="intakeOfframpFlow" sourceRef="Gateway_15h1ahz" targetRef="developmentRequiredErrorEvent" />
    <bpmn:sequenceFlow id="intakeAwardFlow" sourceRef="Gateway_15h1ahz" targetRef="dicAwardMessageEvent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${routingDestination == "AWARD"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0o94d3j" sourceRef="Gateway_1j5whsf" targetRef="Gateway_15h1ahz" />
    <bpmn:sequenceFlow id="intakeRatingFlow" sourceRef="Gateway_1j5whsf" targetRef="dicRatingMessageEvent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${routingDestination == "RATING"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1g0kamk" sourceRef="Gateway_0pug5cd" targetRef="Gateway_1j5whsf" />
    <bpmn:sequenceFlow id="intakeDevelopmentFlow" sourceRef="Gateway_0pug5cd" targetRef="Event_1jgmpr9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${routingDestination == "DEVELOPMENT"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ocjvo1" sourceRef="routingDecisionGateway" targetRef="Gateway_0pug5cd" />
    <bpmn:sequenceFlow id="SequenceFlow_1lhtdn1" sourceRef="Activity_16iensl" targetRef="Activity_1rgzyep" />
    <bpmn:sequenceFlow id="Flow_1b1fxwo" sourceRef="RetrieveSupplementalData" targetRef="EvaluateSupplementalDataActivity" />
    <bpmn:sequenceFlow id="Flow_0ey6j66" sourceRef="EvaluateSupplementalDataActivity" targetRef="Gateway_13naasg" />
    <bpmn:sequenceFlow id="Flow_13ltsoa" name="No" sourceRef="Gateway_13naasg" targetRef="Event_1nplsfb">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!evalSuppMap.supplementalDataComplete}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="benefitTypeFlow" name="Yes" sourceRef="Gateway_13naasg" targetRef="callVeteranRecordProcess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${evalSuppMap.supplementalDataComplete}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="burialEligibilityEndFlow" sourceRef="callInitialDevelopment" targetRef="routingDecisionGateway" />
    <bpmn:startEvent id="startAutoBurial" name="Auto Burial Intake" camunda:asyncAfter="true">
      <bpmn:outgoing>Flow_0fccixz</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0c93si2" messageRef="Message_0dbvv9a" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0fccixz" sourceRef="startAutoBurial" targetRef="Activity_LoadConfiguration" />
    <bpmn:subProcess id="errorIntakeSubProcess" name="Handle Errors" triggeredByEvent="true">
      <bpmn:endEvent id="intakeEndEvent" name="Claim Not Awarded">
        <bpmn:incoming>Flow_0wsi6bi</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="intakeOffRampClaim" name="Offramp Claim" camunda:delegateExpression="${offrampClaimDelegate}">
        <bpmn:incoming>Flow_0c9sdiq</bpmn:incoming>
        <bpmn:outgoing>Flow_0wsi6bi</bpmn:outgoing>
