      <bpmn:startEvent id="intakeErrorCaught" name="Error Caught">
        <bpmn:outgoing>Flow_0c9sdiq</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_1cr6dc6" camunda:errorCodeVariable="errorCode" camunda:errorMessageVariable="errorMessage" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_0c9sdiq" sourceRef="intakeErrorCaught" targetRef="intakeOffRampClaim" />
      <bpmn:sequenceFlow id="Flow_0wsi6bi" sourceRef="intakeOffRampClaim" targetRef="intakeEndEvent" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="eligibilityEndEvent" attachedToRef="callInitialDevelopment">
      <bpmn:outgoing>Flow_13xp4dm</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="EscalationEventDefinition_1pcqkbb" escalationRef="Escalation_0jnawrn" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_13xp4dm" sourceRef="eligibilityEndEvent" targetRef="Event_0i8th2k" />
    <bpmn:endEvent id="Event_0i8th2k" name="Offramped in Eligibility Process">
      <bpmn:incoming>Flow_13xp4dm</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="callVeteranRecordProcess" name="Update Veteran Record" calledElement="veteranRecordProcess">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>benefitTypeFlow</bpmn:incoming>
      <bpmn:outgoing>flowUpdateVetRecord</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="flowUpdateVetRecord" sourceRef="callVeteranRecordProcess" targetRef="callClassificationProcess" />
    <bpmn:sequenceFlow id="Flow_1ka6nn7" sourceRef="callClassificationProcess" targetRef="Activity_16iensl" />
    <bpmn:callActivity id="callClassificationProcess" name="Classification" calledElement="presumptClassifyProcess">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${iDevStartListener}" event="start" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>flowUpdateVetRecord</bpmn:incoming>
      <bpmn:outgoing>Flow_1ka6nn7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="dicAwardMessageEvent" name="Call Award Process">
      <bpmn:incoming>intakeAwardFlow</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0bzdxtl" camunda:delegateExpression="${callAward}" />
    </bpmn:endEvent>
    <bpmn:endEvent id="developmentRequiredErrorEvent" name="Offramp">
      <bpmn:incoming>intakeOfframpFlow</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0gav2ya" errorRef="Error_0ish0mp" />
    </bpmn:endEvent>
    <bpmn:textAnnotation id="TextAnnotation_1blyvnv">
      <bpmn:text>End of Initial Development Process</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0p4zt2p">
      <bpmn:text>Update the Benefit Claim Type then restart the intake process to rerun all initial eligibility checks</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0th23bn">
