      <input id="InputClause_05jiw0x" label="Presumptive Needing Review - Always">
        <inputExpression id="LiteralExpression_0slwzo1" typeRef="boolean">
          <text>isPresumptiveConditionNeedingReviewAlways</text>
        </inputExpression>
      </input>
      <input id="InputClause_1ee1aub" label="Presumptive Needing Review - When Eligible">
        <inputExpression id="LiteralExpression_0jnlgex" typeRef="boolean" expressionLanguage="groovy">
          <text>isPresumptiveConditionNeedingReviewWhenEligible &amp;&amp; pactOverhaulEnabled</text>
        </inputExpression>
      </input>
      <input id="InputClause_1fhol3a" label="Presumptive Result Has Possible Earlier Entitlement Effective Date">
