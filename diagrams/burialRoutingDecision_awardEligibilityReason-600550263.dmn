  <decision id="burialRoutingDecision_awardable" name="Burial Awardable">
    <variable id="InformationItem_184hu4o" name="awardable" typeRef="boolean" />
    <literalExpression id="LiteralExpression_00iqzs8" expressionLanguage="groovy">
      <text>(awardResult != null) &amp;&amp;
(
  (burialResult == null || plotResult == null) ||
  (
    (burialResult.eligible || ["NOT_PROPER_CLAIMANT","DENIED_FUNERAL_HOME_FH_NOT_PROPER_CLAIMANT","NO_COSTS_INCURRED","NO_CP_ENTLMENT_AT_TOD","NO_CP_ENTLMENT_AT_TOD_WITH_UNPROMULGATED_RATING","NOT_TIMELY_FILED","DENY_UNCLAIMED_REMAINS","SERVICE_CONNECTED_BURIAL_PAID","NATIONAL_CEMETERY_BURIAL","STATE_CEMETERY_BURIAL","PAYMENT_BY_OUTSIDE_SOURCE","NOT_ELIGIBLE_CHAR_OF_DISCHARGE_DIS"].contains(burialResult.eligibilityReason))
    &amp;&amp;
    (plotResult.eligible || ["NOT_PROPER_CLAIMANT","NO_COSTS_INCURRED","PRIVATE_RESIDENCE_BURIAL","NO_CP_ENTLMENT_AT_TOD","NO_CP_ENTLMENT_AT_TOD_WITH_UNPROMULGATED_RATING","NOT_TIMELY_FILED","DENY_UNCLAIMED_REMAINS","SERVICE_CONNECTED_BURIAL_PAID","NATIONAL_CEMETERY_BURIAL","STATE_CEMETERY_BURIAL","PAYMENT_BY_OUTSIDE_SOURCE","NOT_ELIGIBLE_CHAR_OF_DISCHARGE_DIS"].contains(plotResult.eligibilityReason))
  )
)</text>
    </literalExpression>
  </decision>
  <decision id="burialRoutingDecision_awardEligibilityReason" name="Burial Award Eligibility Reason">
    <variable id="InformationItem_0mphrls" name="awardEligibilityReason" typeRef="string" />
    <informationRequirement id="InformationRequirement_1bt3ozp">
      <requiredDecision href="#burialRoutingDecision_awardable" />
    </informationRequirement>
    <literalExpression id="LiteralExpression_0dgao3x" expressionLanguage="groovy">
      <text>awardResult == null
  ? null
  : awardable
      ? awardResult.eligibilityReason
      : !(burialResult.eligible || ["NOT_PROPER_CLAIMANT","DENIED_FUNERAL_HOME_FH_NOT_PROPER_CLAIMANT","NO_COSTS_INCURRED","NO_CP_ENTLMENT_AT_TOD","NO_CP_ENTLMENT_AT_TOD_WITH_UNPROMULGATED_RATING","NOT_TIMELY_FILED","DENY_UNCLAIMED_REMAINS","SERVICE_CONNECTED_BURIAL_PAID","NATIONAL_CEMETERY_BURIAL","STATE_CEMETERY_BURIAL","PAYMENT_BY_OUTSIDE_SOURCE","NOT_ELIGIBLE_CHAR_OF_DISCHARGE_DIS"].contains(burialResult.eligibilityReason))
          ? burialResult.eligibilityReason
          : plotResult.eligibilityReason</text>
    </literalExpression>
  </decision>
