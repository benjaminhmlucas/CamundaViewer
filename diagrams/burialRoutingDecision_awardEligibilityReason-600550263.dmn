      <input id="InputClause_15sgmjn" label="VBMSD-191739 FF" biodi:width="150">
        <inputExpression id="LiteralExpression_0il9n2z" typeRef="boolean" expressionLanguage="groovy">
          <text>featureFlags.contains("remarriage-and-lifecycle-logic-update")</text>
        </inputExpression>
