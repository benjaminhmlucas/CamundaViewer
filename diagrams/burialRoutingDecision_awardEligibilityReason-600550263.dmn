  <decision id="dicRoutingTable" name="DIC Routing">
    <decisionTable id="DecisionTable_13f9kjf" hitPolicy="FIRST">
      <input id="InputClause_1sl1q2g" label="Eligible for Rating">
        <inputExpression id="LiteralExpression_1afsmqe" typeRef="boolean">
          <text>ratingResult.eligible</text>
        </inputExpression>
      </input>
      <input id="InputClause_0kcmh7h" label="Rating Required" biodi:width="192">
        <inputExpression id="LiteralExpression_0yjfo1e" typeRef="boolean">
          <text>ratingResult.ratingRequired</text>
        </inputExpression>
      </input>
      <input id="InputClause_08nwvqd" label="Deferred Decision">
        <inputExpression id="LiteralExpression_0iyr9wz" typeRef="boolean" expressionLanguage="groovy">
          <text>featureFlags.contains("enable-deferred-decisions") &amp;&amp; (ratings_ratingProfile?.competencyDecisions?.any {
    it.cmptnyDecnTc == "DEFC" &amp;&amp; it.ptcpntVetId != it.ptcpntDecnId} ||

 ratings_ratingProfile?.scDeathDecisions?.any {
    it.scDeathdecnTc == "D"})</text>
        </inputExpression>
      </input>
      <input id="InputClause_00mvot8" label="Spouse SMP on Veteran Award">
        <inputExpression id="LiteralExpression_1s64alf" typeRef="boolean" expressionLanguage="groovy">
          <text>ratings_ratingProfile != null &amp;&amp; ( ratings_ratingProfile.ancillaryDecisions.any {
    ["ESAA"].contains(it.ancDecnTc)}) &amp;&amp; enableSpouseSmpOnVeteranAward</text>
        </inputExpression>
      </input>
      <input id="InputClause_1fsih89" label="Death In Service">
        <inputExpression id="LiteralExpression_04veb9c" typeRef="boolean" expressionLanguage="groovy">
          <text>veteranInfo.deathInService</text>
        </inputExpression>
      </input>
      <input id="InputClause_0rau509" label="Ready for Award">
        <inputExpression id="LiteralExpression_0sr7ux5" typeRef="boolean">
          <text>readyForAward</text>
        </inputExpression>
      </input>
      <input id="InputClause_0atm220" label="Service Connected&#10;Disabilities">
        <inputExpression id="LiteralExpression_0nzz051" typeRef="boolean">
          <text>hasSCDisabilities</text>
        </inputExpression>
      </input>
      <input id="InputClause_0y0es1f" label="Benefit Claim Type Changed - Manual Review">
        <inputExpression id="LiteralExpression_1gerce6" typeRef="boolean" expressionLanguage="Groovy">
          <text>eligibility_benefitClaimTypeUpdatedReason != null &amp;&amp; eligibility_benefitClaimTypeUpdatedReason.requiresManualReview</text>
        </inputExpression>
      </input>
      <input id="InputClause_0ic87q9" label="Eligible For DIC">
        <inputExpression id="LiteralExpression_04d7jza" typeRef="boolean">
          <text>awardResult.eligible</text>
        </inputExpression>
      </input>
      <input id="InputClause_1mcyt4b" label="DIC Eligibility Reason" biodi:width="464">
        <inputExpression id="LiteralExpression_07vouxi" typeRef="string">
          <text>awardResult.eligibilityReason</text>
        </inputExpression>
      </input>
      <input id="InputClause_0a0fgwo" label="Child Claimed">
        <inputExpression id="LiteralExpression_1tafrsh" typeRef="boolean">
          <text>hasValidChild</text>
        </inputExpression>
      </input>
      <input id="InputClause_0myi25b" label="Remarriage">
        <inputExpression id="LiteralExpression_14nwqb2" typeRef="boolean">
          <text>remarriage</text>
        </inputExpression>
      </input>
      <input id="InputClause_0xkbf9t" label="DIC Result&#10;Selected For Award">
        <inputExpression id="LiteralExpression_0819ju2" typeRef="boolean">
          <text>awardResult.selectedForAward</text>
        </inputExpression>
      </input>
      <input id="InputClause_1l1t6nt" label="Dependents Eligible">
        <inputExpression id="LiteralExpression_1mrm7v0" typeRef="boolean">
          <text>dependencyResult = null or dependencyResult.childResults = null or dependencyResult.eligible</text>
        </inputExpression>
      </input>
      <input id="InputClause_1h1oz1f" label="Dependent Eligiblity Reason">
        <inputExpression id="LiteralExpression_1c3m4n4" typeRef="string" expressionLanguage="groovy">
          <text>dependencyResult != null ? dependencyResult.eligibilityReason : ""</text>
        </inputExpression>
      </input>
      <input id="InputClause_12p1tkl" label="DIC Military Eligibility Reason">
        <inputExpression id="LiteralExpression_0xw4k3j" typeRef="string" expressionLanguage="groovy">
          <text>militaryEligibilityResult == null ? "QUALIFYING_SERVICE" : militaryEligibilityResult.eligibilityReason</text>
        </inputExpression>
      </input>
      <input id="InputClause_1cimak9" label="Final Chance&#10;Check Passed">
        <inputExpression id="LiteralExpression_0sejn6a" typeRef="boolean">
          <text>finalChanceResult = null or  finalChanceResult.eligible</text>
        </inputExpression>
      </input>
      <input id="InputClause_09mw7en" label="Final Chance Eligibility Reason">
        <inputExpression id="LiteralExpression_18xc50v" typeRef="string" expressionLanguage="groovy">
          <text>finalChanceResult != null ? finalChanceResult.eligibilityReason : ""</text>
        </inputExpression>
      </input>
      <input id="InputClause_00eprj3" label="Death Certificate&#10;Missing">
        <inputExpression id="LiteralExpression_0tl68ii" typeRef="boolean">
          <text>deathCertificateMissing</text>
        </inputExpression>
      </input>
      <input id="InputClause_0xki650" label="Death Certificate Failed to Parse">
