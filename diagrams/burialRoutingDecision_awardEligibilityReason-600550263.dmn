        </inputExpression>
      </input>
      <input id="InputClause_1ckruqj" label="DIC Designation">
        <inputExpression id="LiteralExpression_127y6bu" typeRef="string" expressionLanguage="feel">
          <text>awardResult.designation</text>
        </inputExpression>
      </input>
      <input id="InputClause_1dwv3bu" label="Claim Lifecycle Status">
        <inputExpression id="LiteralExpression_0ix3p95" typeRef="string" expressionLanguage="groovy">
          <text>claimExecution.claimLifecycle ? claimExecution.claimLifecycle.name() : null</text>
        </inputExpression>
      </input>
      <input id="InputClause_09tup3i" label="Has PACT SC Death Rating Special Issue" biodi:width="158">
        <inputExpression id="LiteralExpression_18c2yqo" typeRef="boolean" expressionLanguage="groovy">
          <text>hasPactSCDeathSpecialIssue</text>
        </inputExpression>
      </input>
      <input id="InputClause_1huvebj" label="Is Date of Death before 8/11/22" biodi:width="150">
        <inputExpression id="LiteralExpression_0g59wrc" typeRef="date" expressionLanguage="groovy">
          <text>eligibility_dicDeathDate.toDate()</text>
        </inputExpression>
      </input>
      <input id="InputClause_1ycxhh2" label="VBMSD-236450 FF verifyChildEligibilityReview" biodi:width="150">
        <inputExpression id="LiteralExpression_19qnyjm" typeRef="boolean" expressionLanguage="groovy">
          <text>featureFlags.contains("verify-child-eligibility-review")</text>
        </inputExpression>
      </input>
      <input id="InputClause_0iaxb91" label="Eight by Eight Review" biodi:width="150">
