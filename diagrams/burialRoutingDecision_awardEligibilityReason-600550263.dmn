<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:biodi="http://bpmn.io/schema/dmn/biodi/2.0" id="Definitions_0ls9vgr" name="DRD" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.27.0">
  <decision id="burialRoutingTable" name="Burial Routing">
    <informationRequirement id="InformationRequirement_17pomtx">
      <requiredDecision href="#burialRoutingDecision_awardEligibilityReason" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_1i76zm7">
      <requiredDecision href="#burialRoutingDecision_awardable" />
    </informationRequirement>
    <decisionTable id="decisionTable_1" hitPolicy="FIRST">
      <input id="InputClause_0gwxbyu" label="Benefit Type">
        <inputExpression id="LiteralExpression_068sk0p" typeRef="string" expressionLanguage="juel">
          <text>claimExecution.benefitType.code</text>
        </inputExpression>
      </input>
      <input id="input_1" label="Eligible&#10;for&#10;Rating" biodi:width="150">
        <inputExpression id="inputExpression_1" typeRef="boolean">
          <text>ratingResult.eligible</text>
        </inputExpression>
      </input>
      <input id="InputClause_1ua283q" label="Rating&#10;Required" biodi:width="150">
        <inputExpression id="LiteralExpression_0hium1v" typeRef="boolean">
          <text>ratingResult.ratingRequired</text>
        </inputExpression>
      </input>
      <input id="InputClause_0rj5ohq" label="No Rating&#10;Eligibility Reason" biodi:width="222">
        <inputExpression id="LiteralExpression_03pkyzg" typeRef="boolean" expressionLanguage="groovy">
          <text>ratingResult.eligibilityReason == null</text>
        </inputExpression>
      </input>
      <input id="InputClause_097une4" label="Ready&#10;for&#10;Award" biodi:width="150">
        <inputExpression id="LiteralExpression_114czmu" typeRef="boolean">
          <text>readyForAward</text>
        </inputExpression>
      </input>
      <input id="InputClause_053n5ta" label="Death&#10;Certificate&#10;Missing">
        <inputExpression id="LiteralExpression_1hu5pwd" typeRef="boolean">
          <text>deathCertificateMissing</text>
        </inputExpression>
      </input>
      <input id="InputClause_1sbxx43" label="Does Pending DIC Claim Exist?">
        <inputExpression id="LiteralExpression_17gm2ir" typeRef="boolean" expressionLanguage="groovy">
          <text>if (eligibility_pendingDicClaimExists != null) {eligibility_pendingDicClaimExists}</text>
        </inputExpression>
      </input>
      <input id="InputClause_0r9rbs1" label="Death&#10;Certificate&#10;Failed to Parse">
        <inputExpression id="LiteralExpression_1d3rfgp" typeRef="boolean">
          <text>deathCertificateParseFailed</text>
        </inputExpression>
      </input>
      <input id="InputClause_1ne2xr5" label="Death&#10;Certificate&#10;Incomplete">
        <inputExpression id="LiteralExpression_04sozw8" typeRef="boolean">
          <text>deathCertificateIncomplete</text>
        </inputExpression>
      </input>
      <input id="InputClause_0bqxz68" label="Veteran&#10;Location of&#10;Death Missing">
        <inputExpression id="LiteralExpression_0lkjgjs" typeRef="boolean">
          <text>veteranLocationOfDeathMissing</text>
        </inputExpression>
      </input>
      <input id="InputClause_0uovwmt" label="Service&#10;Connected&#10;Disabilities">
        <inputExpression id="LiteralExpression_0d7j7zc" typeRef="boolean">
          <text>hasSCDisabilities</text>
        </inputExpression>
      </input>
      <input id="InputClause_1tz48wd" label="Eligible&#10;for &#10;Award">
        <inputExpression id="LiteralExpression_0ge4loo" typeRef="boolean">
          <text>if (awardResult != null) then (awardResult.eligible) else (null)</text>
        </inputExpression>
      </input>
      <input id="InputClause_01o6zwg" label="Award&#10;Eligibility&#10;Reason" biodi:width="501">
        <inputExpression id="LiteralExpression_0k3jmel" typeRef="string">
          <text>awardEligibilityReason</text>
        </inputExpression>
      </input>
      <input id="InputClause_1p3yq4x" label="Awardable">
        <inputExpression id="LiteralExpression_0b3q9j8" typeRef="boolean">
          <text>awardable</text>
        </inputExpression>
      </input>
      <input id="InputClause_1wgxvsu" label="Veteran Date of Death">
        <inputExpression id="LiteralExpression_0curxei" typeRef="date" expressionLanguage="groovy">
          <text>if (veteranInfo.dateOfDeath){ java.time.LocalDateTime.of(veteranInfo.dateOfDeath, java.time.LocalTime.MIN) }</text>
        </inputExpression>
      </input>
      <input id="InputClause_0m2rvoj" label="VAMC NSC Grant">
        <inputExpression id="LiteralExpression_0fb8xja" typeRef="boolean" expressionLanguage="groovy">
          <text>burialResult != null &amp;&amp;["DEATH_WHILE_PROPERLY_HOSPITALIZED","DEATH_IN_APPROVED_STATE_HOME"].contains(burialResult.eligibilityReason)</text>
        </inputExpression>
      </input>
      <input id="InputClause_0130w46" label="Presumptive Needing Review - Always">
        <inputExpression id="LiteralExpression_0o2bs0a" typeRef="boolean">
          <text>isPresumptiveConditionNeedingReviewAlways</text>
        </inputExpression>
      </input>
      <input id="InputClause_138g6tx" label="Presumptive Needing Review - When Eligible">
        <inputExpression id="LiteralExpression_1le3tpz" typeRef="boolean" expressionLanguage="groovy">
          <text>isPresumptiveConditionNeedingReviewWhenEligible &amp;&amp; pactOverhaulEnabled</text>
        </inputExpression>
      </input>
      <input id="InputClause_0k7fts4" label="Has Error Code">
        <inputExpression id="LiteralExpression_1gdgl16" typeRef="boolean" expressionLanguage="groovy">
          <text>burialEligibilityErrorCode != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_05kffbu" label="Open Tracked Items">
        <inputExpression id="LiteralExpression_1un42e5" typeRef="boolean">
          <text>eligibility_trackedItemExists</text>
        </inputExpression>
      </input>
      <input id="InputClause_1sm87ct" label="FF vbmsr-31399-enable-rating-review-required-individual-unemployability">
        <inputExpression id="LiteralExpression_1juvzl3" typeRef="boolean" expressionLanguage="groovy">
          <text>featureFlags.contains("vbmsr-31399-enable-rating-review-required-individual-unemployability")</text>
        </inputExpression>
      </input>
      <output id="output_1" name="destination" typeRef="string" />
      <output id="OutputClause_0p5k3na" name="offRampError" typeRef="string" />
      <output id="OutputClause_05dgdvn" name="claimStatus" typeRef="string" />
