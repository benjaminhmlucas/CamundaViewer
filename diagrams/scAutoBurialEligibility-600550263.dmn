  <decision id="plotEligibility" name="Plot Eligibility">
    <decisionTable id="DecisionTable_17wb257" hitPolicy="RULE ORDER">
      <input id="InputClause_0udnotj" label="Eligible for SC Burial">
        <inputExpression id="LiteralExpression_1u7ypn7" typeRef="boolean" expressionLanguage="groovy">
          <text>claimExecution.getAwardResult(gov.va.bip.pensionautomation.engine.eligibility.AwardEligibilityBenefitType.SCBB).with{it.eligible &amp;&amp; it.selectedForAward} || eligibility_previousScPayment</text>
        </inputExpression>
      </input>
      <input id="InputClause_1lzib5g" label="17B">
        <inputExpression id="LiteralExpression_0o1rfii" typeRef="boolean">
          <text>claimExecution.benefitsProcessingData.form530GroupData.buriedInFederalCemetery</text>
        </inputExpression>
      </input>
      <input id="InputClause_17yd8xk">
        <inputExpression id="LiteralExpression_0ssor6h" typeRef="boolean" expressionLanguage="groovy">
          <text>burialProcessingIncorrectDenialsFlag</text>
        </inputExpression>
      </input>
      <input id="InputClause_1cx5tc0" label="Tribal Trust Land Burial?">
        <inputExpression id="LiteralExpression_1xxbksr" typeRef="boolean">
          <text>claimExecution.benefitsProcessingData.form530GroupData.veteranBuriedInStateVeteransCemeteryTribalTrustLand</text>
        </inputExpression>
      </input>
      <input id="InputClause_1duqpsv" label="Burial Location Text Matches National Cemetery">
        <inputExpression id="LiteralExpression_1m0phq4" typeRef="boolean" expressionLanguage="groovy">
          <text>deathAndBurialLocationWordsFlag &amp;&amp; claimExecution.benefitsProcessingData.form530GroupData.placeOfBurialOther &amp;&amp; burialLocationFederalCemeteries.contains(
claimExecution.benefitsProcessingData.form530GroupData.placeOfBurialOtherValueSpecified?.toLowerCase())</text>
        </inputExpression>
      </input>
      <input id="InputClause_14gysn3" label="17C">
        <inputExpression id="LiteralExpression_0vhf02a" typeRef="boolean">
          <text>claimExecution.benefitsProcessingData.form530GroupData.veteranBuriedInStateVeteransCemetery</text>
        </inputExpression>
      </input>
      <input id="InputClause_1108ueg" label="Burial Location Text Matches State/Tribal Cemetery">
        <inputExpression id="LiteralExpression_0fzlm5g" typeRef="boolean" expressionLanguage="groovy">
          <text>deathAndBurialLocationWordsFlag &amp;&amp; claimExecution.benefitsProcessingData.form530GroupData.placeOfBurialOther &amp;&amp; burialLocationStateCemeteries.contains(
claimExecution.benefitsProcessingData.form530GroupData.placeOfBurialOtherValueSpecified?.toLowerCase())</text>
        </inputExpression>
      </input>
      <input id="InputClause_0jzizgd" label="Burial Location Text Matches Plot Determination Review Needed">
        <inputExpression id="LiteralExpression_1hfif5r" typeRef="boolean" expressionLanguage="groovy">
          <text>deathAndBurialLocationWordsFlag &amp;&amp; claimExecution.benefitsProcessingData.form530GroupData.placeOfBurialOther &amp;&amp; plotDeterminationReviewWords.contains(
claimExecution.benefitsProcessingData.form530GroupData.placeOfBurialOtherValueSpecified?.toLowerCase())</text>
        </inputExpression>
      </input>
      <input id="InputClause_08wordt" label="Plot Entitlement" biodi:width="192">
        <inputExpression id="LiteralExpression_0y2dw5c" typeRef="long">
          <text>eligibility_plotEntitlement</text>
        </inputExpression>
      </input>
      <input id="InputClause_0q4lsrg" label="Previous Plot Payment">
        <inputExpression id="LiteralExpression_064qem4" typeRef="boolean" expressionLanguage="groovy">
