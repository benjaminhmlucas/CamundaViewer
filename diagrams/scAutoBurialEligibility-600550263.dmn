<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:biodi="http://bpmn.io/schema/dmn/biodi/2.0" id="Definitions_08v6q4j" name="DRD" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.34.0">
  <decision id="nscBurialEligibility" name="NSC Burial Eligibility">
    <informationRequirement id="InformationRequirement_1vmn26b">
      <requiredDecision href="#claimantEligibility" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_00mf6cf">
      <requiredDecision href="#veteranEligibility" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0i794d9">
      <requiredDecision href="#vamcEligibility" />
    </informationRequirement>
    <decisionTable id="decisionTable_1" hitPolicy="RULE ORDER">
      <input id="InputClause_12uznzl" label="VAMC Eligible">
        <inputExpression id="LiteralExpression_0cskirt" typeRef="boolean" expressionLanguage="groovy">
          <text>vamcEligible.any{it == true} &amp;&amp; vamcEligible.findAll{it == false}.size() == 1</text>
        </inputExpression>
      </input>
      <input id="InputClause_17ikaay" label="Veteran Eligible">
        <inputExpression id="LiteralExpression_10j6xhy" typeRef="boolean" expressionLanguage="groovy">
          <text>!veteranEligible.any {it == false}</text>
        </inputExpression>
      </input>
      <input id="InputClause_1nnyl4m" label="Eligibility Denial Reason">
        <inputExpression id="LiteralExpression_1dr3jaz" typeRef="string" expressionLanguage="groovy">
          <text>eligibilityReason.any {it == "NON_VERIFIED_QUALIFYING_SERVICE"} ? "NON_VERIFIED_QUALIFYING_SERVICE" : eligibilityReason[0]</text>
        </inputExpression>
      </input>
      <input id="InputClause_1smdja0" label="Claimant Eligible">
        <inputExpression id="LiteralExpression_1rr437i" typeRef="boolean" expressionLanguage="groovy">
          <text>!claimantEligible.any {it == false}</text>
        </inputExpression>
      </input>
      <input id="InputClause_0454ts7" label="Claim Timely Filed">
        <inputExpression id="LiteralExpression_052239k" typeRef="boolean">
          <text>nscCriteria.timeBetweenDeathAndClaimReceivedDateLessThan2Year</text>
        </inputExpression>
      </input>
      <input id="InputClause_0tbab0p" label="NSC Entitlement">
        <inputExpression id="LiteralExpression_1rr64z3" typeRef="double">
          <text>eligibility_nscBurialEntitlement</text>
        </inputExpression>
      </input>
      <input id="InputClause_1f10dkz" label="NSC Entitlement Already Paid">
        <inputExpression id="LiteralExpression_0okioql" typeRef="boolean" expressionLanguage="juel">
          <text>${eligibility_alreadyPaidNscBurialAmount &gt;= eligibility_nscBurialEntitlement}</text>
        </inputExpression>
      </input>
      <input id="InputClause_1bkcj6d" label="13B - Death Location Exists">
        <inputExpression id="LiteralExpression_02htam2" typeRef="boolean" expressionLanguage="groovy">
          <text>claimExecution.benefitsProcessingData.form530GroupData.deathLocationVAMC || claimExecution.benefitsProcessingData.form530GroupData.deathLocationStateHome || claimExecution.benefitsProcessingData.form530GroupData.deathLocationNursingHome || claimExecution.benefitsProcessingData.form530GroupData.deathLocationOther || claimExecution.benefitsProcessingData.form530GroupData.deathLocationOtherValueSpecified?.trim()</text>
        </inputExpression>
      </input>
      <input id="input_1" label="C&#38;P at Death">
        <inputExpression id="inputExpression_4fe6663e" typeRef="boolean">
          <text>nscCriteria.receivedCompAtDeath or nscCriteria.receivedPensionAtDeath</text>
        </inputExpression>
      </input>
      <input id="InputClause_1y58nkn" label="Rated for SC Disability at Death">
        <inputExpression id="LiteralExpression_1ok4s25" typeRef="long">
          <text>nscCriteria.scDisabilityPercentageAtDeath</text>
        </inputExpression>
      </input>
      <input id="InputClause_0hzlwmn" label="Received Military Retire Pay">
        <inputExpression id="LiteralExpression_1f538li" typeRef="boolean">
          <text>nscCriteria.receivedMilitaryRetirePay</text>
        </inputExpression>
      </input>
      <input id="InputClause_1atxc60" label="VAMC Death (13A)">
        <inputExpression id="LiteralExpression_09vnwof" typeRef="boolean">
          <text>claimExecution.benefitsProcessingData.form530GroupData.vaMedicalCenterDeath</text>
        </inputExpression>
      </input>
      <input id="InputClause_1ve0obf" label="Death in VA Care (13B excluding Other)">
        <inputExpression id="LiteralExpression_0lq6iqc" typeRef="boolean" expressionLanguage="groovy">
          <text>claimExecution.benefitsProcessingData.form530GroupData.deathLocationVAMC || claimExecution.benefitsProcessingData.form530GroupData.deathLocationStateHome || claimExecution.benefitsProcessingData.form530GroupData.deathLocationNursingHome</text>
        </inputExpression>
      </input>
      <input id="InputClause_11upej7" label="Unclaimed Remains (15B)">
        <inputExpression id="LiteralExpression_1nu82lf" typeRef="boolean">
          <text>claimExecution.benefitsProcessingData.form530GroupData.seekingBurialBenefits</text>
        </inputExpression>
      </input>
      <input id="InputClause_0am77dj" label="Funeral Home">
        <inputExpression id="LiteralExpression_1cmyw5q" typeRef="boolean" expressionLanguage="groovy">
          <text>(claimExecution.benefitsProcessingData.form530GroupData.claimantFuneralHome &amp;&amp; !claimExecution.benefitsProcessingData.form530GroupData.claimantFamilial ||
claimExecution.benefitsProcessingData.form530GroupData.medicalExaminer &amp;&amp; !claimExecution.benefitsProcessingData.form530GroupData.claimantFamilial &amp;&amp; enable530UnclaimedRemainsProcessing)</text>
        </inputExpression>
      </input>
      <input id="InputClause_1he835e" label="Burial Benefit Type">
        <inputExpression id="LiteralExpression_1ma9m29" typeRef="string" expressionLanguage="groovy">
          <text>eligibility_burialBenefit ? eligibility_burialBenefit.name() : null</text>
        </inputExpression>
      </input>
      <input id="InputClause_1uteutw" label="C&#38;P Claim Pending at Death">
        <inputExpression id="LiteralExpression_0teyqug" typeRef="boolean">
          <text>nscCriteria.openClaimWithGrantCompORPension</text>
        </inputExpression>
      </input>
      <input id="InputClause_0oj0c82" label="Termination Date Mismatch Flag">
        <inputExpression id="LiteralExpression_1ohr81i" typeRef="boolean" expressionLanguage="feel">
          <text>terminationDateMismatchFlag</text>
        </inputExpression>
      </input>
      <input id="InputClause_1llkm12" label="CPL Benefits Termination Reason">
        <inputExpression id="LiteralExpression_0nu3a1p" typeRef="" expressionLanguage="groovy">
          <text>awards_cplAward?.basicEligibilities.collect { it.getCode() }</text>
        </inputExpression>
      </input>
      <input id="InputClause_1msggae" label="CPL Benefits Termination Date is before First of Month of Date of Death">
        <inputExpression id="LiteralExpression_1glj0tt" typeRef="boolean" expressionLanguage="groovy">
          <text>nscCriteria.cplTerminatedBeforeDeath</text>
        </inputExpression>
      </input>
      <input id="InputClause_1hexnhj" label="Pending Claim is for Compensation">
        <inputExpression id="LiteralExpression_0fgvxzr" typeRef="boolean">
          <text>nscCriteria.openClaimIsCompensation</text>
        </inputExpression>
      </input>
      <input id="InputClause_17qn0hb" label="Compensable on Unpromulgated Rating at TOD">
        <inputExpression id="LiteralExpression_0ar1jm0" typeRef="string" expressionLanguage="groovy">
          <text>nscCriteria.scCompensableAtDeath</text>
        </inputExpression>
      </input>
      <input id="InputClause_1hi4byh" label="Accrued Claim Awarded After Death">
        <inputExpression id="LiteralExpression_180p8r3" typeRef="boolean">
          <text>nscCriteria.accruedClaimAwardedAfterDeath</text>
        </inputExpression>
      </input>
      <input id="InputClause_06gcwmb" label="LifeCycle Status">
        <inputExpression id="LiteralExpression_02uvl7y" typeRef="string" expressionLanguage="feel">
          <text>claimData.getClaimLifecycleStatus</text>
        </inputExpression>
      </input>
      <input id="InputClause_13tevpi" label="Veteran IU at DOD">
        <inputExpression id="LiteralExpression_1wvqwsj" typeRef="boolean" expressionLanguage="groovy">
          <text>nscCriteria.iuAtDeath</text>
        </inputExpression>
      </input>
      <input id="InputClause_0iz1zl1" label="FF vbmsr-31399-enable-rating-review-required-individual-unemployability">
        <inputExpression id="LiteralExpression_11o4qlu" typeRef="boolean" expressionLanguage="groovy">
          <text>featureFlags.contains("vbmsr-31399-enable-rating-review-required-individual-unemployability")</text>
        </inputExpression>
      </input>
      <output id="output_1" label="Burial Eligibility Decision" name="eligibilityReason" typeRef="string" />
