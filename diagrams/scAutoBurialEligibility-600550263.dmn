  <decision id="scAutoBurialEligibility" name="Auto Burial Eligibility">
    <decisionTable id="DecisionTable_0rxaxsp" hitPolicy="COLLECT">
      <input id="InputClause_1vve6k2" label="SC Burial Entitlment">
        <inputExpression id="LiteralExpression_0scymq7" typeRef="double">
          <text>eligibility_scBurialEntitlement</text>
        </inputExpression>
      </input>
      <input id="InputClause_0qhetrq" label="Claimant Address Exists">
        <inputExpression id="LiteralExpression_10idipo" typeRef="boolean" expressionLanguage="juel">
          <text>not(claimantAddresses == null) &amp;&amp; not(empty(claimantAddresses))</text>
        </inputExpression>
      </input>
      <input id="InputClause_0rg63qs" label="Eligible Based On Rating">
        <inputExpression id="LiteralExpression_1ua30nv" typeRef="boolean">
          <text>claimExecution.ratingResult.eligible</text>
        </inputExpression>
      </input>
      <input id="InputClause_021xjjw" label="Rating Eligibility Reason">
        <inputExpression id="LiteralExpression_0dvc969" typeRef="string">
          <text>claimExecution.ratingResult.eligibilityReason</text>
        </inputExpression>
      </input>
      <input id="InputClause_0tirbd0" label="Rating Required">
        <inputExpression id="LiteralExpression_0ctnz1m" typeRef="boolean">
          <text>claimExecution.ratingResult.ratingRequired</text>
        </inputExpression>
      </input>
      <input id="InputClause_0a0g18p" label="C&#38;P at Death">
        <inputExpression id="LiteralExpression_0kqzpu4" typeRef="boolean">
          <text>eligibility_receivedCompAtDeath or eligibility_receivedPensionAtDeath</text>
        </inputExpression>
      </input>
      <output id="OutputClause_06dt4bv" label="Burial Eligibility Decision" name="eligibilityReason" typeRef="string" />
