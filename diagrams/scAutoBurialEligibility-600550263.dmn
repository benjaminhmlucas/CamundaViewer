  <decision id="scBurialEligibility" name="SC Burial Eligibility">
    <informationRequirement id="InformationRequirement_0yqa2n9">
      <requiredDecision href="#claimantEligibility" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_10ve72r">
      <requiredDecision href="#veteranEligibility" />
    </informationRequirement>
    <decisionTable id="DecisionTable_04p0bjf" hitPolicy="RULE ORDER">
      <input id="InputClause_1w8q5lc" label="Veteran Eligible">
        <inputExpression id="LiteralExpression_0t9rdgb" typeRef="boolean" expressionLanguage="groovy">
          <text>!veteranEligible.any {it == false}</text>
        </inputExpression>
      </input>
      <input id="InputClause_1xb08fo" label="Eligibility Denial Reason">
        <inputExpression id="LiteralExpression_1dpskrn" typeRef="string" expressionLanguage="groovy">
          <text>eligibilityReason.any {it == "MIN_ACTIVE_DUTY_NOT_MET"} ? "MIN_ACTIVE_DUTY_NOT_MET" : eligibilityReason[0]</text>
        </inputExpression>
      </input>
      <input id="InputClause_1pwnrde" label="Claimant Eligible">
        <inputExpression id="LiteralExpression_165k0am" typeRef="boolean" expressionLanguage="groovy">
          <text>!claimantEligible.any {it == false}</text>
        </inputExpression>
      </input>
      <input id="InputClause_1c8dfbh" label="SC Burial Entitlment">
        <inputExpression id="LiteralExpression_0izvfhd" typeRef="double">
          <text>eligibility_scBurialEntitlement</text>
        </inputExpression>
      </input>
      <input id="InputClause_1fbtgtw" label="SC Burial Entitlement Already Paid">
        <inputExpression id="LiteralExpression_1oldgs5" typeRef="boolean" expressionLanguage="groovy">
          <text>eligibility_alreadyPaidScBurialAmount &gt;= eligibility_scBurialEntitlement</text>
        </inputExpression>
      </input>
      <input id="InputClause_0h0jhu3" label="Claimant Address Exists">
        <inputExpression id="LiteralExpression_16j8nte" typeRef="boolean" expressionLanguage="juel">
          <text>not(claimantAddresses == null) &amp;&amp; not(empty(claimantAddresses))</text>
        </inputExpression>
      </input>
      <input id="InputClause_1eqx12c" label="Eligible Based On Rating">
        <inputExpression id="LiteralExpression_1w1mhlr" typeRef="boolean">
          <text>claimExecution.ratingResult.eligible</text>
        </inputExpression>
      </input>
      <input id="InputClause_0q6fpnr" label="Rating Eligibility Reason">
        <inputExpression id="LiteralExpression_09yi70x" typeRef="string">
          <text>claimExecution.ratingResult.eligibilityReason</text>
        </inputExpression>
      </input>
      <input id="InputClause_1itqby0" label="Rating Required">
        <inputExpression id="LiteralExpression_1sqyat7" typeRef="boolean">
          <text>claimExecution.ratingResult.ratingRequired</text>
        </inputExpression>
      </input>
      <input id="InputClause_0gw0kib" label="C&#38;P at Death">
        <inputExpression id="LiteralExpression_1v40d9h" typeRef="boolean" expressionLanguage="feel">
          <text>eligibility_receivedCompAtDeath or eligibility_receivedPensionAtDeath</text>
        </inputExpression>
