  <decision id="vamcEligibility" name="VAMC Eligibility">
    <informationRequirement id="InformationRequirement_1pkd0nz">
      <requiredDecision href="#veteranEligibility" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0eoc3p0">
      <requiredDecision href="#claimantEligibility" />
    </informationRequirement>
    <decisionTable id="DecisionTable_06xgttp" hitPolicy="RULE ORDER">
      <input id="InputClause_1xzmfgp" label="Veteran Eligible">
        <inputExpression id="LiteralExpression_0m0eepp" typeRef="boolean" expressionLanguage="groovy">
          <text>!veteranEligible.any {it == false}</text>
        </inputExpression>
      </input>
      <input id="InputClause_00w77ym" label="Claimant Eligible">
        <inputExpression id="LiteralExpression_1cve66z" typeRef="boolean" expressionLanguage="groovy">
          <text>!claimantEligible.any {it == false}</text>
        </inputExpression>
      </input>
      <input id="InputClause_1jj0g2q" label="Claim Lifecycle Phase">
        <inputExpression id="LiteralExpression_1vbsll6" typeRef="string" expressionLanguage="groovy">
          <text>claimExecution.claimLifecycle ? claimExecution.claimLifecycle.name() : null</text>
        </inputExpression>
      </input>
      <input id="InputClause_0bz6u7b" label="VAMC Death (13A)">
        <inputExpression id="LiteralExpression_0xz0dpr" typeRef="boolean">
          <text>claimExecution.benefitsProcessingData.form530GroupData.vaMedicalCenterDeath</text>
        </inputExpression>
      </input>
      <input id="InputClause_0txet4y" label="Death in VAMC (13B)">
        <inputExpression id="LiteralExpression_0u21871" typeRef="boolean">
          <text>claimExecution.benefitsProcessingData.form530GroupData.deathLocationVAMC</text>
        </inputExpression>
      </input>
      <input id="InputClause_1f67nod" label="Death in State Veterans Home (13B)">
        <inputExpression id="LiteralExpression_1lxixns" typeRef="boolean">
          <text>claimExecution.benefitsProcessingData.form530GroupData.deathLocationStateHome</text>
        </inputExpression>
      </input>
      <input id="InputClause_1p2b5hc" label="Death in Nursing Home - VA contract (13B)">
        <inputExpression id="LiteralExpression_0p4r612" typeRef="boolean">
          <text>claimExecution.benefitsProcessingData.form530GroupData.deathLocationNursingHome</text>
        </inputExpression>
      </input>
      <input id="InputClause_1cwztyq" label="Death Location Other (13B)">
        <inputExpression id="LiteralExpression_0fxrma7" typeRef="boolean">
          <text>claimExecution.benefitsProcessingData.form530GroupData.deathLocationOther</text>
        </inputExpression>
      </input>
      <input id="InputClause_0461eh1" label="Death Location Text Review Needed">
        <inputExpression id="LiteralExpression_1yk3uzv" typeRef="boolean" expressionLanguage="groovy">
          <text>deathAndBurialLocationWordsFlag &amp;&amp;  locationOfDeathDiscrepancyWords.contains(claimExecution.benefitsProcessingData.form530GroupData.deathLocationOtherValueSpecified?.toLowerCase())</text>
        </inputExpression>
      </input>
      <input id="InputClause_153cqq1" label="Death in VA Care Facility (13B excluding Other)">
        <inputExpression id="LiteralExpression_16dpioq" typeRef="boolean" expressionLanguage="groovy">
          <text>claimExecution.benefitsProcessingData.form530GroupData.deathLocationVAMC || claimExecution.benefitsProcessingData.form530GroupData.deathLocationStateHome || claimExecution.benefitsProcessingData.form530GroupData.deathLocationNursingHome</text>
        </inputExpression>
      </input>
      <input id="InputClause_0gbbb33" label="Unclaimed Remains (15B)">
        <inputExpression id="LiteralExpression_1u5qt1r" typeRef="boolean">
          <text>claimExecution.benefitsProcessingData.form530GroupData.seekingBurialBenefits</text>
        </inputExpression>
      </input>
      <input id="InputClause_0kww7ol" label="Funeral Home">
        <inputExpression id="LiteralExpression_12uq3up" typeRef="boolean" expressionLanguage="groovy">
          <text>(claimExecution.benefitsProcessingData.form530GroupData.claimantFuneralHome &amp;&amp; !claimExecution.benefitsProcessingData.form530GroupData.claimantFamilial ||
claimExecution.benefitsProcessingData.form530GroupData.medicalExaminer &amp;&amp; !claimExecution.benefitsProcessingData.form530GroupData.claimantFamilial &amp;&amp; enable530UnclaimedRemainsProcessing)</text>
        </inputExpression>
      </input>
      <output id="OutputClause_1dv5dqf" label="VAMC Eligible" name="vamcEligible" typeRef="boolean" />
      <output id="OutputClause_0i28em3" label="VAMC Eligibility Reason" name="eligibilityReason" typeRef="string" />
