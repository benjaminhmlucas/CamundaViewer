        </inputExpression>
      </input>
      <input id="InputClause_1pte65x" label="18A">
        <inputExpression id="LiteralExpression_0mr2bp7" typeRef="boolean">
          <text>claimExecution.benefitsProcessingData.form530GroupData.federalOrStateGovernmentOrEmployerContribute</text>
        </inputExpression>
      </input>
      <input id="InputClause_1pkil20" label="18B &#62; 0">
        <inputExpression id="LiteralExpression_07l0gc0" typeRef="boolean">
          <text>claimExecution.benefitsProcessingData.form530GroupData.employerContributionAmount &gt; 0</text>
        </inputExpression>
      </input>
      <input id="InputClause_0eqny8w" label="19-530ez">
        <inputExpression id="LiteralExpression_0op23qk" typeRef="boolean">
