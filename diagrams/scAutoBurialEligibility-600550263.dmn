  <decision id="claimantEligibility" name="Claimant Eligibility">
    <decisionTable id="DecisionTable_0hplo4i" hitPolicy="RULE ORDER">
      <input id="InputClause_0gacuu8" label="Burial Benefit Type">
        <inputExpression id="LiteralExpression_13p2a76" typeRef="string" expressionLanguage="groovy">
          <text>eligibility_burialBenefit ? eligibility_burialBenefit.name() : null</text>
        </inputExpression>
      </input>
      <input id="InputClause_0cvwi3u" label="Prior Decision was Grant">
        <inputExpression id="LiteralExpression_1v0bmjd" typeRef="boolean" expressionLanguage="groovy">
          <text>awards_currentAward?.burial?.burialDecisions?.findAll { it.burialBenefitType.code == eligibility_burialBenefit?.name()  }*.eligibilityDecision.any { it.grant }</text>
        </inputExpression>
      </input>
      <input id="InputClause_02xa686" label="Prior Decision Amount">
        <inputExpression id="LiteralExpression_1sgfap0" typeRef="double" expressionLanguage="groovy">
          <text>//We expect only one burial decision of each benefit type, grabbing the highest amount if there are somehow multiple decisions
awards_currentAward?.burial?.burialDecisions?.findAll { it.burialBenefitType.code == eligibility_burialBenefit?.name()  }.findAll {it. eligibilityDecision.grant}*.amount.max()</text>
        </inputExpression>
      </input>
      <input id="InputClause_15evffm" label="Claimant is Dead">
        <inputExpression id="LiteralExpression_14yr1gx" typeRef="boolean">
          <text>claimantPersonalInfoData.dateOfDeath != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_0fbya6z" label="Proper Claimant">
        <inputExpression id="LiteralExpression_1qxnkie" typeRef="boolean" expressionLanguage="groovy">
          <text>claimExecution.benefitsProcessingData.form530GroupData.claimantFamilial || (!claimExecution.benefitsProcessingData.form530GroupData.relationshipSpouse &amp;&amp; !claimExecution.benefitsProcessingData.form530GroupData.relationshipChild &amp;&amp; !claimExecution.benefitsProcessingData.form530GroupData.relationshipParent &amp;&amp; !claimExecution.benefitsProcessingData.form530GroupData.relationshipExecutor &amp;&amp; !claimExecution.benefitsProcessingData.form530GroupData.relationshipOther &amp;&amp; (claimantPersonalInfoData.relationship?.name == "Child" || claimantPersonalInfoData.relationship?.name == "Spouse" || claimantPersonalInfoData.relationship?.name == "Parent"))</text>
        </inputExpression>
      </input>
      <input id="InputClause_0acnw6d" label="Proper Claimant #2">
        <inputExpression id="LiteralExpression_1af4b18" typeRef="boolean" expressionLanguage="groovy">
          <text>def form530 = claimExecution.benefitsProcessingData.form530GroupData

form530.claimantFamilial || (form530.relationshipOther &amp;&amp; !properClaimantExclusionWords.any{word -&gt; form530.relationshipOtherValueSpecified?.replaceAll("\\s","")?.toLowerCase()?.contains(word)})</text>
        </inputExpression>
      </input>
      <input id="InputClause_10liqyu" label="Burial Processing Incorrect Denials Flag">
        <inputExpression id="LiteralExpression_0y5sp3b" typeRef="boolean" expressionLanguage="groovy">
          <text>burialProcessingIncorrectDenialsFlag</text>
        </inputExpression>
      </input>
      <input id="InputClause_0zecys9" label="Burial Costs Incurred">
        <inputExpression id="LiteralExpression_1lnmkdn" typeRef="boolean">
          <text>if not(claimExecution.benefitsProcessingData.form530GroupData.incurredExpensesVeteranBurialYes) and not(claimExecution.benefitsProcessingData.form530GroupData.incurredExpensesVeteranBurialNo) then null
else claimExecution.benefitsProcessingData.form530GroupData.incurredExpensesVeteranBurial</text>
        </inputExpression>
      </input>
      <input id="InputClause_082zj4k" label="Plot Costs Incurred">
        <inputExpression id="LiteralExpression_0ld0hij" typeRef="boolean">
          <text>if not(claimExecution.benefitsProcessingData.form530GroupData.incurExpensesVeteranPlotYes) and not(claimExecution.benefitsProcessingData.form530GroupData.incurExpensesVeteranPlotNo) then null
else claimExecution.benefitsProcessingData.form530GroupData.incurExpensesVeteranPlot</text>
        </inputExpression>
      </input>
      <input id="InputClause_17m739y" label="Funeral Costs Incurred (eFolder)">
        <inputExpression id="LiteralExpression_0421q1m" typeRef="boolean" expressionLanguage="groovy">
          <text>eligibility_validFuneralBillExists</text>
        </inputExpression>
      </input>
      <input id="InputClause_1idwm3z" label="Unclaimed Remains (15B)">
        <inputExpression id="LiteralExpression_0erlskt" typeRef="boolean">
          <text>claimExecution.benefitsProcessingData.form530GroupData.seekingBurialBenefits</text>
        </inputExpression>
      </input>
      <input id="InputClause_0kxzjve" label="Funeral Home or Medical Examiner">
        <inputExpression id="LiteralExpression_14vqfrf" typeRef="boolean" expressionLanguage="groovy">
          <text>(claimExecution.benefitsProcessingData.form530GroupData.claimantFuneralHome &amp;&amp; !claimExecution.benefitsProcessingData.form530GroupData.claimantFamilial ||
claimExecution.benefitsProcessingData.form530GroupData.medicalExaminer &amp;&amp; !claimExecution.benefitsProcessingData.form530GroupData.claimantFamilial)</text>
        </inputExpression>
      </input>
      <input id="InputClause_1pokopl" label="Cemetery or Mausoleum">
        <inputExpression id="LiteralExpression_13w52li" typeRef="boolean" expressionLanguage="groovy">
          <text>def form530 = claimExecution.benefitsProcessingData.form530GroupData

form530.placeOfBurialCemetery || form530.placeOfBurialMausoleum ?:
(form530.payloadNamespace?.urn == "urn:pension_automation:530:apr-2017" &amp;&amp; cemeteryOrMausoleumWords.any {word -&gt; form530.placeOfBurialOtherValueSpecified?.replaceAll("\\s","")?.toLowerCase()?.contains(word)})</text>
        </inputExpression>
      </input>
      <input id="InputClause_0rm4j9l" label="Enable 530 Unclaimed Remains Processing">
        <inputExpression id="LiteralExpression_0l0zl3c" typeRef="boolean" expressionLanguage="feel">
          <text>enable530UnclaimedRemainsProcessing</text>
        </inputExpression>
      </input>
      <input id="InputClause_063ecnf" label="Veteran DOD">
        <inputExpression id="LiteralExpression_092t5pb" typeRef="date" expressionLanguage="groovy">
          <text>if (veteranInfo.dateOfDeath){ java.time.LocalDateTime.of(veteranInfo.dateOfDeath, java.time.LocalTime.MIN) }</text>
        </inputExpression>
      </input>
      <input id="InputClause_0od6cc1" label="Claim Lifecycle Status">
        <inputExpression id="LiteralExpression_03d4in6" typeRef="string" expressionLanguage="groovy">
          <text>claimExecution.claimSummary?.claimLifecycleStatus</text>
        </inputExpression>
      </input>
      <input id="InputClause_0e3td3p" label="Verify Funeral Bill Flag">
        <inputExpression id="LiteralExpression_0vz9vtj" typeRef="boolean" expressionLanguage="groovy">
          <text>verifyFuneralBillAfterTransportationDecisionFlag</text>
        </inputExpression>
      </input>
      <output id="OutputClause_0wmj97u" label="Claimant Eligible" name="claimantEligible" typeRef="boolean" />
      <output id="OutputClause_1yjcdx2" label="Eligibility Denial Reason" name="eligibilityReason" typeRef="string" />
