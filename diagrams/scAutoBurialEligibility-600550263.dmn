  <decision id="transportationEligibility" name="Transportation Eligibility">
    <informationRequirement id="InformationRequirement_12hlv9s">
      <requiredDecision href="#claimantEligibility" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_1s5rc1i">
      <requiredDecision href="#veteranEligibility" />
    </informationRequirement>
    <decisionTable id="DecisionTable_0fb05kg" hitPolicy="RULE ORDER">
      <input id="InputClause_0uvsdtg" label="Veteran Eligible">
        <inputExpression id="LiteralExpression_1wk4ulx" typeRef="boolean" expressionLanguage="groovy">
          <text>!veteranEligible.any {it == false}</text>
        </inputExpression>
      </input>
      <input id="InputClause_1qgjt5u" label="Eligibility Denial Reason">
        <inputExpression id="LiteralExpression_0qxyzku" typeRef="string" expressionLanguage="groovy">
          <text>eligibilityReason.any {it == "NON_VERIFIED_QUALIFYING_SERVICE"} ? "NON_VERIFIED_QUALIFYING_SERVICE" : eligibilityReason[0]</text>
        </inputExpression>
      </input>
      <input id="InputClause_1eybn14" label="Claim Timely Filed">
        <inputExpression id="LiteralExpression_0dpdnfg" typeRef="boolean">
          <text>nscCriteria.timeBetweenDeathAndClaimReceivedDateLessThan2Year</text>
        </inputExpression>
      </input>
      <input id="InputClause_05wdfz4" label="NSC Entitlement">
        <inputExpression id="LiteralExpression_0zlo6gn" typeRef="double">
          <text>eligibility_nscBurialEntitlement</text>
        </inputExpression>
      </input>
      <input id="InputClause_1foa46p" label="Claimant Eligible">
        <inputExpression id="LiteralExpression_150yrl7" typeRef="boolean" expressionLanguage="groovy">
          <text>!claimantEligible.any {it == false}</text>
        </inputExpression>
      </input>
      <input id="InputClause_1bh6sto" label="Death in VA Care Facility (13B excluding Other) ">
        <inputExpression id="LiteralExpression_04t45nh" typeRef="boolean" expressionLanguage="groovy">
          <text>claimExecution.benefitsProcessingData.form530GroupData.deathLocationVAMC || claimExecution.benefitsProcessingData.form530GroupData.deathLocationStateHome || claimExecution.benefitsProcessingData.form530GroupData.deathLocationNursingHome</text>
        </inputExpression>
      </input>
      <input id="InputClause_0ve4sqb" label="Other (13B)">
        <inputExpression id="LiteralExpression_12kab32" typeRef="boolean" expressionLanguage="groovy">
          <text>claimExecution.benefitsProcessingData.form530GroupData.deathLocationOther == null ? false : claimExecution.benefitsProcessingData.form530GroupData.deathLocationOther</text>
        </inputExpression>
      </input>
      <input id="InputClause_0zfdcu7" label="Buried in National Cemetery (17B)">
        <inputExpression id="LiteralExpression_1s3u9xp" typeRef="boolean">
          <text>claimExecution.benefitsProcessingData.form530GroupData.buriedInFederalCemetery</text>
        </inputExpression>
      </input>
      <input id="InputClause_0ylr79j" label="Received Comp at Death">
        <inputExpression id="LiteralExpression_0etgtww" typeRef="boolean">
          <text>nscCriteria.receivedCompAtDeath</text>
        </inputExpression>
      </input>
      <input id="InputClause_1p9o7zm" label="Eligible for SC Death">
        <inputExpression id="LiteralExpression_1tabjne" typeRef="boolean" expressionLanguage="juel">
          <text>claimExecution.ratingResult.eligible</text>
        </inputExpression>
      </input>
      <input id="InputClause_1jz9z3x" label="Burial Location is &#34;State&#34; or &#34;Tribal&#34; Cemetery">
        <inputExpression id="LiteralExpression_08wjxsl" typeRef="boolean" expressionLanguage="javascript">
          <text>(claimExecution.benefitsProcessingData.form530GroupData.placeOfBurialOtherValueSpecified != null &amp;&amp; 
    (claimExecution.benefitsProcessingData.form530GroupData.placeOfBurialOther &amp;&amp; 
        (claimExecution.benefitsProcessingData.form530GroupData.placeOfBurialOtherValueSpecified.toLowerCase().indexOf("state") &gt;= 0 
        || claimExecution.benefitsProcessingData.form530GroupData.placeOfBurialOtherValueSpecified.toLowerCase().indexOf("tribal") &gt;=0)
    )
) || claimExecution.benefitsProcessingData.form530GroupData.veteranBuriedInStateVeteransCemetery
|| claimExecution.benefitsProcessingData.form530GroupData.veteranBuriedInStateVeteransCemeteryTribalTrustLand</text>
        </inputExpression>
      </input>
      <input id="InputClause_1dhuw4e" label="Received Military Retire Pay">
        <inputExpression id="LiteralExpression_10arxuv" typeRef="boolean">
          <text>nscCriteria.receivedMilitaryRetirePay</text>
        </inputExpression>
      </input>
      <input id="InputClause_05ekl8k" label="Veteran DOD">
        <inputExpression id="LiteralExpression_1g7lozs" typeRef="date" expressionLanguage="groovy">
          <text>if (veteranInfo.dateOfDeath){ java.time.LocalDateTime.of(veteranInfo.dateOfDeath, java.time.LocalTime.MIN) }</text>
        </inputExpression>
      </input>
      <input id="InputClause_0j1k3p3" label="NSC Burial Allowance">
        <inputExpression id="LiteralExpression_0nm63um" typeRef="boolean" expressionLanguage="groovy">
          <text>(completedAutomation &amp;&amp; eligibility_alreadyPaidNscBurialAmount &gt;= eligibility_nscBurialEntitlement) || claimExecution.getAwardResult(gov.va.bip.pensionautomation.engine.eligibility.AwardEligibilityBenefitType.NSCBB).with{it.eligible &amp;&amp; it.selectedForAward}</text>
        </inputExpression>
      </input>
      <input id="InputClause_02tjk7w" label="SC Burial Allowance">
        <inputExpression id="LiteralExpression_0wahfrg" typeRef="boolean" expressionLanguage="groovy">
          <text>(completedAutomation &amp;&amp; eligibility_alreadyPaidScBurialAmount &gt;= eligibility_scBurialEntitlement) || claimExecution.getAwardResult(gov.va.bip.pensionautomation.engine.eligibility.AwardEligibilityBenefitType.SCBB).with{it.eligible &amp;&amp; it.selectedForAward} || eligibility_previousScPayment</text>
        </inputExpression>
      </input>
      <input id="InputClause_01ds2e4" label="Received Pension at Death">
        <inputExpression id="LiteralExpression_0iv07c8" typeRef="boolean">
          <text>nscCriteria.receivedPensionAtDeath</text>
        </inputExpression>
      </input>
      <input id="InputClause_0e80rpg" label="Claimant is Funeral Home">
        <inputExpression id="LiteralExpression_1qg56x0" typeRef="boolean" expressionLanguage="groovy">
          <text>claimExecution.benefitsProcessingData.form530GroupData.claimantFuneralHome
</text>
        </inputExpression>
      </input>
      <input id="InputClause_0qog54i" label="Unclaimed Remains CertifiedÂ ">
        <inputExpression id="LiteralExpression_05eq3lo" typeRef="boolean" expressionLanguage="groovy">
          <text>claimExecution.benefitsProcessingData.form530GroupData.seekingBurialBenefits
</text>
        </inputExpression>
      </input>
      <input id="InputClause_0c2fxu6" label="Feature Flag: enableNoCostIncurred">
        <inputExpression id="LiteralExpression_0dvupbc" typeRef="boolean" expressionLanguage="groovy">
          <text>enableNoCostIncurred</text>
        </inputExpression>
      </input>
      <output id="OutputClause_1ooc3h6" label="Burial Eligibility Decision" name="eligibilityReason" typeRef="string" />
