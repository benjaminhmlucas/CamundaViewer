  <decision id="veteranEligibility" name="Veteran Eligibility">
    <decisionTable id="DecisionTable_099y4ks" hitPolicy="RULE ORDER">
      <input id="InputClause_0j2i2d5" label="Claim Lifecycle Phase">
        <inputExpression id="LiteralExpression_0kp95z7" typeRef="string" expressionLanguage="groovy">
          <text>claimExecution.claimLifecycle ? claimExecution.claimLifecycle.name() : null</text>
        </inputExpression>
      </input>
      <input id="InputClause_1flaasc" label="Burial Benefit Type">
        <inputExpression id="LiteralExpression_1dnkkz9" typeRef="string" expressionLanguage="groovy">
          <text>eligibility_burialBenefit ? eligibility_burialBenefit.name() : null</text>
        </inputExpression>
      </input>
      <input id="InputClause_1izu4w7" label="Buried in Federal Cemetery (17B)">
        <inputExpression id="LiteralExpression_02mhl5q" typeRef="boolean" expressionLanguage="groovy">
          <text>claimExecution.benefitsProcessingData?.form530GroupData?.buriedInFederalCemetery</text>
        </inputExpression>
      </input>
      <input id="InputClause_0b7uwxv" label="Veteran Died in Service">
        <inputExpression id="LiteralExpression_0szbptd" typeRef="boolean">
          <text>veteranInfo.deathInService</text>
        </inputExpression>
      </input>
      <input id="InputClause_08896jz" label="Military Eligibility">
        <inputExpression id="LiteralExpression_0snz1ga" typeRef="string" expressionLanguage="groovy">
          <text>eligibility_burialMilitaryEligibilityResult == null ? "QUALIFYING_SERVICE" : eligibility_burialMilitaryEligibilityResult</text>
        </inputExpression>
      </input>
      <output id="OutputClause_0t1lrqy" label="Veteran Eligible" name="veteranEligible" typeRef="boolean" />
      <output id="OutputClause_1in0hp5" label="Eligibility Denial Reason" name="eligibilityReason" typeRef="string" />
