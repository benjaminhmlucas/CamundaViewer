  <bpmn:collaboration id="Collaboration_1bt45k8">
    <bpmn:participant id="veteranRecordProcessActivity" name="Veteran Record Activity (Intake)" processRef="veteranRecordProcess" />
    <bpmn:participant id="vetRecordActivityViaAwards" name="Vet Record Activity (Awards)" processRef="vetRecordProcessAwards" />
  </bpmn:collaboration>
  <bpmn:process id="veteranRecordProcess" name="Veteran Record Process" isExecutable="true" camunda:versionTag="1.0.0">
    <bpmn:startEvent id="startVetRecordProcess" name="Start Veteran Record Process">
      <bpmn:outgoing>flowFromStartToSavePos</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flowFromStartToSavePos" sourceRef="startVetRecordProcess" targetRef="savePeriodOfServiceTask" />
    <bpmn:sequenceFlow id="flowFromSavePosToEnd" sourceRef="savePeriodOfServiceTask" targetRef="endVetRecordProcess" />
    <bpmn:serviceTask id="savePeriodOfServiceTask" name="Save Period of Service" camunda:delegateExpression="${savePeriodOfService}">
      <bpmn:incoming>flowFromStartToSavePos</bpmn:incoming>
      <bpmn:outgoing>flowFromSavePosToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endVetRecordProcess" name="End Veteran Record Process">
      <bpmn:incoming>flowFromSavePosToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="vetRecordProcessAwards" name="Vet Record Process (Awards)" isExecutable="true" camunda:versionTag="1.0.0">
    <bpmn:startEvent id="startVetRecordViaAwards" name="Start Veteran Record Process (Awards)">
      <bpmn:outgoing>toSaveDDInformation</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toSaveDDInformation" sourceRef="startVetRecordViaAwards" targetRef="saveDirectDepositInformation" />
    <bpmn:sequenceFlow id="fromSaveDDToEnd" sourceRef="saveDirectDepositInformation" targetRef="endVetRecordProcessAwards" />
    <bpmn:serviceTask id="saveDirectDepositInformation" name="Save Direct Deposit Information" camunda:delegateExpression="${saveDirectDepositInformation}">
      <bpmn:incoming>toSaveDDInformation</bpmn:incoming>
      <bpmn:outgoing>fromSaveDDToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endVetRecordProcessAwards" name="End Veteran Record Process (Awards)">
      <bpmn:incoming>fromSaveDDToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
