        </inputExpression>
      </input>
      <input id="InputClause_1f3kx9y" label="Service Connected Death">
        <inputExpression id="LiteralExpression_1roihg3" typeRef="boolean" expressionLanguage="groovy">
          <text>claimExecution.ratingResult != null &amp;&amp; claimExecution.ratingResult.eligible</text>
        </inputExpression>
      </input>
      <input id="InputClause_1s001h7" label="Rating Eligibiliity Reason">
        <inputExpression id="LiteralExpression_031u6pa" typeRef="string" expressionLanguage="groovy">
          <text>claimExecution.ratingResult?.eligibilityReason</text>
        </inputExpression>
      </input>
      <output id="output_1" label="Benefit Claim Type Update Eligibility Reason" name="updateBenefitClaimTypeReason" typeRef="string" />
