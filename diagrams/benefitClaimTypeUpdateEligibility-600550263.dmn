  <decision id="benefitClaimTypeUpdateEligibility" name="Evaluate Benefit Claim Type Update Eligibility">
    <extensionElements>
      <biodi:bounds x="410" y="150" width="180" height="80" />
    </extensionElements>
    <decisionTable id="decisionTable_1" hitPolicy="FIRST">
      <input id="input_1" label="EP Code">
        <inputExpression id="inputExpression_1" typeRef="integer">
          <text>eligibility_benefitClaimTypeUpdateCriteria.currentEPCode</text>
        </inputExpression>
      </input>
      <input id="InputClause_0wj5l37" label="Death by Suicide">
        <inputExpression id="LiteralExpression_0v2v4qb" typeRef="boolean" expressionLanguage="Groovy">
          <text>eligibility_benefitClaimTypeUpdateCriteria.isMannerOfDeathSuicide</text>
        </inputExpression>
      </input>
      <input id="InputClause_0pkul7c" label="Is Service Connected To PTSD Related">
        <inputExpression id="LiteralExpression_0rkj9co" typeRef="boolean" expressionLanguage="Groovy">
          <text>eligibility_benefitClaimTypeUpdateCriteria.isServiceConnectedForPTSDRelated</text>
        </inputExpression>
      </input>
      <input id="InputClause_1ag7ukb" label="Form 534 Block 7 Claiming Service Connected Cause of Death">
