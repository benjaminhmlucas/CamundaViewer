        </inputExpression>
      </input>
      <input id="InputClause_1rc3ltb" label="Form 534 Block 35 Get Dic Under 38 Usc 1151">
        <inputExpression id="LiteralExpression_0zmma1x" typeRef="boolean" expressionLanguage="Groovy">
          <text>eligibility_benefitClaimTypeUpdateCriteria.block35GetDicUnder38Usc1151</text>
        </inputExpression>
      </input>
      <input id="InputClause_0w9mnry" label="Form 534 EZ Block 7A Get Dic Under PACT">
        <inputExpression id="LiteralExpression_024voq7" typeRef="boolean">
          <text>eligibility_benefitClaimTypeUpdateCriteria.block7AGetDicUnderPACT</text>
        </inputExpression>
      </input>
      <input id="InputClause_1ewl3sv" label="Form 530 Block 13A Service Connected Death Pending">
        <inputExpression id="LiteralExpression_1791nf5" typeRef="boolean" expressionLanguage="Groovy">
