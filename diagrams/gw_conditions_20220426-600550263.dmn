  <decision id="gw_conditions_original" name="Original Gulf War Conditions">
    <variable id="InformationItem_00i1o8s" name="gwConditions" typeRef="string" />
    <literalExpression id="LiteralExpression_03bw7k3" expressionLanguage="groovy">
      <text>gwCODS = [
    "allergic rhinitis",
    "anal cancer",
    "asbestosis",
    "asthma",
    "bacterial rhinitis",
    "basal cell carcinoma of the cheek",
    "basal cell carcinoma of the lip",
    "basal cell carcinoma of the nose",
    "bone cancer of the skull",
    "brain cancer",
    "breast cancer",
    "bronchiectasis",
    "caplans syndrome",
    "cervical cancer",
    "cervical spine cancer",
    "chronic bronchitis",
    "chronic obstructive pulmonary disease",
    "chronic pleural fibrosis",
    "chronic rhinitis",
    "chronic sinusitis",
    "colon cancer",
    "constrictive bronchiolitis",
    "copd",
    "dental cancer",
    "desquamative interstitial pneumonia",
    "duodenal cancer",
    "ear cancer",
    "ear carcinoma",
    "emphysema",
    "eosinophilic granuloma of lung",
    "eosinophilic granuloma of lung",
    "esophageal cancer",
    "ethmoid sinusitis",
    "eye cancer",
    "eye carcinoma",
    "frontal sinusitis",
    "gallbladder cancer",
    "gastrointestinal cancer",
    "glioblastoma",
    "granulomatous disease",
    "granulomatous rhinitis",
    "head cancer",
    "hodgkins disease",
    "hodgkins lymphoma",
    "hypersensitivity pneumonitis",
    "interstitial lung disease",
    "kidney cancer",
    "large cell lung cancer",
    "large intestine cancer",
    "laryngeal cancer",
    "lip cancer",
    "liver cancer",
    "lung adenocarcinoma",
    "lung cancer",
    "lung carcinoma",
    "lymph node carcinoma",
    "lymphoblastic lymphoma",
    "malignant lymphoma of the skull",
    "malignant neoplasm of the breast",
    "malignant neoplasm of the ear",
    "maxillary sinusitis",
    "melanoma",
    "melanoma of the eye",
    "mesothelioma",
    "mouth cancer",
    "multiple myeloma of the head",
    "multiple myeloma of the neck",
    "neck cancer",
    "nhl",
    "non hodgkins lymphoma",
    "non small cell lung cancer",
    "obliterative bronchiolitis",
    "oral cancer",
    "ovarian cancer",
    "pancreatic cancer",
    "pancreatic cancer",
    "pansinusitis",
    "penile cancer",
    "peribronchial fibrosis",
    "pharyngeal cancer",
    "pleural plaques",
    "pleural thickening",
    "pleuritis",
    "pneumoconiosis",
    "prostate cancer",
    "pulmonary alveolar proteinosis",
    "pulmonary fibrosis",
    "pulmonary fibrosis",
    "pulmonary tuberculosis",
    "rectal cancer",
    "respiratory cancer",
    "rhinitis",
    "rhinoscleroma",
    "rhinosinusitis",
    "sarcoidosis",
    "sinusitis",
    "small cell lung cancer",
    "small intestine cancer",
    "soft tissue sarcoma of the neck",
    "soft tissue sarcoma of the skull",
    "sphenoid sinusitis",
    "squamous cell carcinoma of the cheek",
    "squamous cell carcinoma of the lip",
    "squamous cell carcinoma of the nose",
    "stomach cancer",
    "tb",
    "testicular cancer",
    "throat cancer",
    "thyroid cancer",
    "thyroid carcinoma",
    "tongue cancer",
    "tracheal cancer",
    "tuberculosis",
    "uterine cancer",
    "vaginal cancer",
    "vasomotor rhinitis",
    "wegeners granulomatosis"
]

gwCODS.sort{a,b -&gt; b.length() &lt;=&gt; a.length()}

gwCODS.find{condition -&gt;
    intake_pactPresumptiveCriteria.getCausesOfDeathFromDeathCert().any{cause_of_death -&gt;
        cause_of_death.toLowerCase().matches(".*\\b$condition\\b.*")
    }
}</text>
    </literalExpression>
  </decision>
  <decision id="gulf-war-presumptive-pact" name="Gulf War Exposure">
    <informationRequirement id="InformationRequirement_0cumn6m">
      <requiredDecision href="#gw_conditions_original" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0pz0xdw">
      <requiredDecision href="#gw_conditions_20220426" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0rpjcux">
      <requiredDecision href="#gw_conditions_20210805" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_064ai9u">
      <requiredDecision href="#gw_conditions_pact" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0to4kbm">
      <requiredDecision href="#Decision_0bakpkm" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0mqpz4p">
      <requiredDecision href="#Decision_1rjvmhx" />
    </informationRequirement>
    <decisionTable id="DecisionTable_1twvjk7" hitPolicy="COLLECT" biodi:annotationsWidth="430">
      <input id="InputClause_0xwot6n" label="Benefit Type">
        <inputExpression id="LiteralExpression_03tv0dh" typeRef="string" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getBenefitType()</text>
        </inputExpression>
      </input>
      <input id="InputClause_1v2e4pi" label="Claim Lifecycle Status">
        <inputExpression id="LiteralExpression_15vs6px" typeRef="string" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getClaimLifecycleStatus()</text>
        </inputExpression>
      </input>
      <input id="InputClause_07vyauq" label="Claim Lifecycle Phase">
        <inputExpression id="LiteralExpression_02jww42" typeRef="string" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getClaimLifecycle()</text>
        </inputExpression>
      </input>
      <input id="InputClause_0shygfo" label="Veteran DOD">
        <inputExpression id="LiteralExpression_14orvxg" typeRef="date" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getDateOfDeath().atStartOfDay()</text>
        </inputExpression>
      </input>
      <input id="InputClause_0z0rftw" label="Claim Within 1 Year of Death" biodi:width="192">
        <inputExpression id="LiteralExpression_1sjh2lt" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.isClaimWithin1YearOfDeath()</text>
        </inputExpression>
      </input>
      <input id="InputClause_1af7e0w" label="Date of Claim">
        <inputExpression id="LiteralExpression_1o06ky0" typeRef="date" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.claimReceivedDate?.atStartOfDay()</text>
        </inputExpression>
      </input>
      <input id="InputClause_1wijels" label="Valid ITF Within 1 Year of Death">
        <inputExpression id="LiteralExpression_0whs2rx" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.isItfWithin1YearOfDeath()</text>
        </inputExpression>
      </input>
      <input id="InputClause_0zw9aj6" label="Valid ITF Date" biodi:width="192">
        <inputExpression id="LiteralExpression_0mxtwh3" typeRef="date" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.itfDate?.atStartOfDay()</text>
        </inputExpression>
      </input>
      <input id="InputClause_0xtmwwy" label="Last Service Era">
        <inputExpression id="LiteralExpression_08nycgu" typeRef="string">
          <text>intake_pactPresumptiveCriteria.getLastServiceEra()</text>
        </inputExpression>
      </input>
      <input id="InputClause_0yalu0r" label="Missing RAD Date?" biodi:width="192">
        <inputExpression id="LiteralExpression_11a07ae" typeRef="boolean">
          <text>intake_pactPresumptiveCriteria.isMissingMostRecentRAD()</text>
        </inputExpression>
      </input>
      <input id="InputClause_1o5n0ry" label="Years Between RAD and DOD">
        <inputExpression id="LiteralExpression_1d4durl" typeRef="long" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getYearsBetweenRadAndDateOfDeath()</text>
        </inputExpression>
      </input>
      <input id="InputClause_0de8bd9" label="GW Original COD Match" camunda:inputVariable="gwConditions">
        <inputExpression id="LiteralExpression_18uk4u4" typeRef="boolean" expressionLanguage="groovy">
          <text>gwConditions != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_060778l" label="GW COD Effective 8/05/21 Match" camunda:inputVariable="gwCODS_08_05_21">
        <inputExpression id="LiteralExpression_08ajugb" typeRef="boolean" expressionLanguage="groovy">
          <text>gwCODS_08_05_21[0] != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_08avchf" label="Has Any SC Disability Matching GW COD Effective 8/05/21" biodi:width="192" camunda:inputVariable="gwCODS_08_05_21">
        <inputExpression id="LiteralExpression_05lwvw1" typeRef="boolean" expressionLanguage="groovy">
          <text>gwCODS_08_05_21[1] != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_0n2l1g9" label="Latest SC Disability Matching GW COD Effective 8/05/21" camunda:inputVariable="gwCODS_08_05_21">
        <inputExpression id="LiteralExpression_1n9kz7j" typeRef="boolean" expressionLanguage="groovy">
          <text>gwCODS_08_05_21[2] != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_1kuoywc" label="GW COD Effective 4/26/22 Match" camunda:inputVariable="gwCODS_04_26_22">
        <inputExpression id="LiteralExpression_1yz12a6" typeRef="boolean" expressionLanguage="groovy">
          <text>gwCODS_04_26_22[0] != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_03q4wd7" label="Has Any SC Disability Matching GW COD Effective 4/26/22" biodi:width="192" camunda:inputVariable="gwCODS_04_26_22">
        <inputExpression id="LiteralExpression_1ff4371" typeRef="boolean" expressionLanguage="groovy">
          <text>gwCODS_04_26_22[1] != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_14c7u0t" label="GW COD Effective 8/10/22 (PACT) Match" biodi:width="192" camunda:inputVariable="gw_aug10_2022">
        <inputExpression id="LiteralExpression_1tnkotf" typeRef="boolean" expressionLanguage="groovy">
          <text>gw_aug10_2022[0] != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_02n168q" label="Death Cert GW COD Effective 1/2/25" camunda:inputVariable="gw_jan02_2025">
        <inputExpression id="LiteralExpression_161nubv" typeRef="boolean" expressionLanguage="groovy">
          <text>gw_jan02_2025[0] != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_0q6n2l6" label="Rating GW COD Effective 1/2/25" camunda:inputVariable="gw_jan02_2025">
        <inputExpression id="LiteralExpression_1khdexz" typeRef="boolean" expressionLanguage="groovy">
          <text>gw_jan02_2025[1] != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_09yd4fm" label="Death Cert GW COD Effective 1/10/25" camunda:inputVariable="gw_jan10_2025">
        <inputExpression id="LiteralExpression_0ql7onq" typeRef="boolean" expressionLanguage="groovy">
          <text>gw_jan10_2025[0] !=null  </text>
        </inputExpression>
      </input>
      <input id="InputClause_1rfzfkx" label="Rating GW COD Effective 1/10/25" camunda:inputVariable="gw_jan10_2025">
        <inputExpression id="LiteralExpression_1soat0e" typeRef="boolean" expressionLanguage="groovy">
          <text>gw_jan10_2025[1] != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_08nzu04" label="Latest Rated SC Disability Matching GW COD Effective 8/10/22 (PACT)" biodi:width="214" camunda:inputVariable="gw_aug10_2022">
        <inputExpression id="LiteralExpression_1kp57of" typeRef="boolean" expressionLanguage="groovy">
          <text>gw_aug10_2022[2] != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_0zgimoj" label="Has GW or GWP Rating Special Issue">
        <inputExpression id="LiteralExpression_0687ub8" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getRatingSpecialIssues() != null &amp;&amp;
 !intake_pactPresumptiveCriteria.getRatingSpecialIssues().isEmpty() &amp;&amp;
 intake_pactPresumptiveCriteria.getRatingSpecialIssues().any{ 'GWP'.equalsIgnoreCase(it.spisTc)} || intake_pactPresumptiveCriteria.getRatingSpecialIssues().any{ 'GW'.equalsIgnoreCase(it.spisTc)}</text>
        </inputExpression>
      </input>
      <input id="InputClause_1px3c6x" label="Has BPE Rating Special Issue">
        <inputExpression id="LiteralExpression_0pi0n2s" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getRatingSpecialIssues() != null &amp;&amp; !intake_pactPresumptiveCriteria.getRatingSpecialIssues().isEmpty() &amp;&amp; intake_pactPresumptiveCriteria.getRatingSpecialIssues().any{ 'BPE'.equalsIgnoreCase(it.spisTc)}</text>
        </inputExpression>
      </input>
      <input id="InputClause_0t6ve9m" label="Has PM Rating Special Issue">
        <inputExpression id="LiteralExpression_0rsvoeo" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.hasGWRatingSpecialIssueWithBasis</text>
        </inputExpression>
      </input>
      <input id="InputClause_1gbpd2l" label="Has GWP3.320 Rating Special Issue">
        <inputExpression id="LiteralExpression_19ok8wk" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getRatingSpecialIssues() != null &amp;&amp; !intake_pactPresumptiveCriteria.getRatingSpecialIssues().isEmpty() &amp;&amp; intake_pactPresumptiveCriteria.getRatingSpecialIssues().any{ 'GWP3.320'.equalsIgnoreCase(it.spisTc)}</text>
        </inputExpression>
      </input>
      <input id="InputClause_1bdf8of" label="Has GW Death Special Issue of GW, GWP or BPE">
        <inputExpression id="LiteralExpression_1u0xz1i" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getDeathSpecialIssues() != null &amp;&amp; !intake_pactPresumptiveCriteria.getDeathSpecialIssues().isEmpty() &amp;&amp; intake_pactPresumptiveCriteria.getDeathSpecialIssues().any{ 'GW'.equalsIgnoreCase(it)} || intake_pactPresumptiveCriteria.getDeathSpecialIssues().any{ 'GWP'.equalsIgnoreCase(it)} || intake_pactPresumptiveCriteria.getDeathSpecialIssues().any{ 'BPE'.equalsIgnoreCase(it)}</text>
        </inputExpression>
      </input>
      <input id="InputClause_1gwwbys" label="Has GW Death Special Issue of GWP3.320">
        <inputExpression id="LiteralExpression_1eh13vj" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getDeathSpecialIssues() != null &amp;&amp; !intake_pactPresumptiveCriteria.getDeathSpecialIssues().isEmpty() &amp;&amp; intake_pactPresumptiveCriteria.getDeathSpecialIssues().any{ 'GWP3.320'.equalsIgnoreCase(it)}</text>
        </inputExpression>
      </input>
      <input id="InputClause_0djn143" label="Latest Rated SC Disability Death Special Issue">
        <inputExpression id="LiteralExpression_0sbkto9" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getDeathSpecialIssues() != null &amp;&amp; !intake_pactPresumptiveCriteria.getDeathSpecialIssues().isEmpty() &amp;&amp; ( intake_pactPresumptiveCriteria.getDeathSpecialIssues().any{ 'GWP'.equalsIgnoreCase(it)} || intake_pactPresumptiveCriteria.getDeathSpecialIssues().any{ 'GW'.equalsIgnoreCase(it)} || intake_pactPresumptiveCriteria.getDeathSpecialIssues().any{ 'BPE'.equalsIgnoreCase(it)} || intake_pactPresumptiveCriteria.getDeathSpecialIssues().any{ 'GWP3.320'.equalsIgnoreCase(it)} )</text>
        </inputExpression>
      </input>
      <input id="InputClause_1eaocbv" label="Has GW Contention Special Issue">
        <inputExpression id="LiteralExpression_065fdbp" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getContentionSpecialIssues() != null &amp;&amp; !intake_pactPresumptiveCriteria.getContentionSpecialIssues().isEmpty() &amp;&amp; ( intake_pactPresumptiveCriteria.getContentionSpecialIssues().any{ 'GW'.equalsIgnoreCase(it)} || intake_pactPresumptiveCriteria.getContentionSpecialIssues().any{ 'GWP'.equalsIgnoreCase(it)} || intake_pactPresumptiveCriteria.getContentionSpecialIssues().any{ 'GWPAH'.equalsIgnoreCase(it)} || intake_pactPresumptiveCriteria.getContentionSpecialIssues().any{ 'GWPRC'.equalsIgnoreCase(it)} || intake_pactPresumptiveCriteria.getContentionSpecialIssues().any{ 'GWP3.320'.equalsIgnoreCase(it)} )</text>
        </inputExpression>
      </input>
      <input id="InputClause_1sxirsh" label="Has GW Corporate Flash">
        <inputExpression id="LiteralExpression_1284a62" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.getCorporateFlashes() != null &amp;&amp; 
 !intake_pactPresumptiveCriteria.getCorporateFlashes().isEmpty() &amp;&amp; 
 intake_pactPresumptiveCriteria.getCorporateFlashes().any{'Gulf War Toxic Exposure Verified'.equalsIgnoreCase(it)} ||
 intake_pactPresumptiveCriteria.getCorporateFlashes().any{'Toxic Exposure - Sec. 1119 Covered Veteran'.equalsIgnoreCase(it)}</text>
        </inputExpression>
      </input>
      <input id="InputClause_1x4ulh7" label="Claiming Income and Assets">
        <inputExpression id="LiteralExpression_1gd7jqj" typeRef="boolean" expressionLanguage="groovy">
          <text>intake_pactPresumptiveCriteria.isIncomeAndAssetsAnswered()</text>
        </inputExpression>
      </input>
      <input id="InputClause_1va6425" label="FF VBMSD-198779 evaluateGulfWarPresumptiveConditions">
        <inputExpression id="LiteralExpression_1luizc3" typeRef="boolean" expressionLanguage="groovy">
          <text>evaluateGulfWarPresumptiveConditions</text>
        </inputExpression>
      </input>
      <input id="InputClause_0xl0eo6" label="FF VBMSD-198146 recognizeRareRespiratoryCancersFlag">
        <inputExpression id="LiteralExpression_06ht2e0" typeRef="boolean" expressionLanguage="groovy">
          <text>featureFlags.contains("recognize-rare-respiratory-cancers-flag")</text>
        </inputExpression>
      </input>
      <input id="InputClause_1tusp69" label="FF VBMSD-312500 enable-as21-as27-offramp">
        <inputExpression id="LiteralExpression_1nti6or" typeRef="boolean" expressionLanguage="groovy">
          <text>featureFlags.contains("enable-as21-as27-offramp")</text>
        </inputExpression>
      </input>
