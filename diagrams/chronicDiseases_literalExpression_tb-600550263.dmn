  <decision id="chronicDiseases_literalExpression_all" name="Chronic Diseases">
    <variable id="InformationItem_143f4hz" name="chronicCondition" typeRef="string" />
    <literalExpression id="LiteralExpression_01dty05" expressionLanguage="groovy">
      <text>chronicConditions = [
    "anemia primary",
    "arteriosclerosis",
    "brain hemorrhage",
    "brain thrombosis",
    "bronchiectasis",
    "buergers disease",
    "calculi of the bladder",
    "calculi of the gallbladder",
    "calculi of the kidney",
    "calculus in bladder",
    "calculus in gallbladder",
    "calculus in kidney",
    "cardiovascular renal disease",
    "cirrhosis liver",
    "coccidiodomycosis",
    "degenerative arthritis",
    "diabetes mellitus",
    "dm",
    "dmii",
    "encephalitis",
    "endocarditis",
    "endocrinopathies",
    "epilepsis",
    "hansens disease",
    "hodgkins disease",
    "htn",
    "hypertension",
    "leukemia",
    "lupus",
    "malignant tumor",
    "multiple sclerosis",
    "muscular atrophy",
    "myatheia gravis",
    "myelitis",
    "myocarditis",
    "nephritis",
    "organic disease of the nervous system",
    "osteitis deformans",
    "osteomalacia",
    "pagets disease",
    "palsey bulbar",
    "paralysis agitans",
    "peptic ulcer",
    "primary anemia",
    "psychosis",
    "purpura",
    "raynauds disease",
    "renal calculi",
    "renal calculus",
    "sarchoidosis",
    "scleroderma",
    "stomach ulcer",
    "syringomyelia",
    "thromboangitis"
]

if (intake_pactPresumptiveCriteria.causesOfDeathFromDeathCert == null) return null;

cods = intake_pactPresumptiveCriteria.causesOfDeathFromDeathCert as String[]
for(int i = 0; i &lt; cods.size(); i++) {
   cods[i] = cods[i].replaceAll("pulmonary[^A-Za-z0-9]*?(hypertension|htn)", "")
}

chronicConditions.find{condition -&gt; cods.any{cause_of_death -&gt; cause_of_death.matches(".*\\b$condition\\b.*")}}</text>
    </literalExpression>
  </decision>
  <decision id="chronicDiseases_literalExpression_als" name="Chronic ALS">
    <variable id="InformationItem_0q2o9tz" name="alsCodMatchType" typeRef="string" />
    <literalExpression id="LiteralExpression_1j0kbqq" expressionLanguage="groovy">
      <text>gov.va.bip.pensionautomation.engine.service.util.CauseOfDeathALSPredicate predicate = new 
        gov.va.bip.pensionautomation.engine.service.util.CauseOfDeathALSPredicate();

alsCodMatchType = ""

if(intake_pactPresumptiveCriteria.causesOfDeathFromDeathCert != null &amp;&amp; !intake_pactPresumptiveCriteria.causesOfDeathFromDeathCert.isEmpty()){
   primaryCod = intake_pactPresumptiveCriteria.causesOfDeathFromDeathCert.get(0)
   contributoryCods = intake_pactPresumptiveCriteria.causesOfDeathFromDeathCert.findAll { it != primaryCod }
   
   primaryMatch = predicate.test(primaryCod)
   contributoryMatch = contributoryCods.any{ cause_of_death -&gt; predicate.test(cause_of_death) }

   alsCodMatchType = primaryMatch ? "primaryALS" : contributoryMatch ? "contributoryALS" : ""

}

alsCodMatchType</text>
    </literalExpression>
  </decision>
  <decision id="chronicDiseases_literalExpression_ms" name="Chronic MS">
    <variable id="InformationItem_1kcqg6f" name="msCodMatch" typeRef="boolean" />
    <literalExpression id="LiteralExpression_0ri660l" expressionLanguage="groovy">
      <text>msConditions = ["ms", "multiple sclerosis"]

msCodMatch = msConditions.any{ 
    condition -&gt; intake_pactPresumptiveCriteria.causesOfDeathFromDeathCert.any{
        cause_of_death -&gt; cause_of_death.matches(".*\\b$condition\\b.*")
    } 
}</text>
    </literalExpression>
  </decision>
  <decision id="chronicDiseases_literalExpression_tb" name="Chronic TB">
    <variable id="InformationItem_1j42eeq" name="tbCodMatch" typeRef="boolean" />
    <literalExpression id="LiteralExpression_0tp7zz3" expressionLanguage="groovy">
      <text>tbConditions = ["tuberculosis"]

tbCodMatch = tbConditions.any{ 
    condition -&gt; intake_pactPresumptiveCriteria.causesOfDeathFromDeathCert.any{
        cause_of_death -&gt; cause_of_death.matches(".*\\b$condition\\b.*")
    } 
}</text>
    </literalExpression>
  </decision>
