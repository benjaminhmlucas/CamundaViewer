<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_016mifp" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.27.0">
  <bpmn:collaboration id="eligibilityCollaboration">
    <bpmn:documentation>DIC</bpmn:documentation>
    <bpmn:participant id="eligibility" name="Eligibility" processRef="eligibilityProcess" />
    <bpmn:participant id="Participant_0dgggb7" name="Determine Event Date Process" processRef="determineEventDateProcess" />
  </bpmn:collaboration>
  <bpmn:process id="eligibilityProcess" name="eligibility" isExecutable="true" camunda:versionTag="1.0.0" camunda:historyTimeToLive="15">
    <bpmn:startEvent id="eligibilityStartEvent" name="Start Eligibility">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${eligibilityStartListener}" event="start" />
      </bpmn:extensionElements>
      <bpmn:outgoing>getRatingInputFlow</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="getRatingInputFlow" sourceRef="eligibilityStartEvent" targetRef="gatewayRouteByBenefitType" />
    <bpmn:endEvent id="idevEndEvent" name="End Development">
      <bpmn:incoming>joinRouteByBenefitTypeOutflow</bpmn:incoming>
      <bpmn:incoming>Flow_1w8zgdl</bpmn:incoming>
      <bpmn:incoming>autoBurialEligibilityOutflow</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="joinRouteByBenefitType">
      <bpmn:incoming>burialEligibilityOutflow</bpmn:incoming>
      <bpmn:incoming>routeByBenefitTypeDefaultFlow</bpmn:incoming>
      <bpmn:incoming>flowFromIpEligibility</bpmn:incoming>
      <bpmn:incoming>deathBenefitCompleteFlow</bpmn:incoming>
      <bpmn:outgoing>joinRouteByBenefitTypeOutflow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="evalDeathBenefitResults" name="Evaluate Death Benefit Eligibility Results" camunda:delegateExpression="${selectDeathBenefitEligibilityResults}">
      <bpmn:incoming>parallelExecutionToResultEvaluation</bpmn:incoming>
      <bpmn:outgoing>deathBenefitCompleteFlow</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="deathBenefitParallelGatewayEnd">
      <bpmn:incoming>survivorsPensionEligibilityOutflow</bpmn:incoming>
      <bpmn:incoming>dicEligibilityOutflow</bpmn:incoming>
      <bpmn:outgoing>parallelExecutionToResultEvaluation</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="gatewayRouteByBenefitType" name="Route By Benefit Type" default="routeByBenefitTypeDefaultFlow">
      <bpmn:incoming>getRatingInputFlow</bpmn:incoming>
      <bpmn:outgoing>routeByBenefitTypeBurialFlow</bpmn:outgoing>
      <bpmn:outgoing>routeByBenefitTypeDicFlow</bpmn:outgoing>
      <bpmn:outgoing>routeByBenefitTypeDefaultFlow</bpmn:outgoing>
      <bpmn:outgoing>flowToIpEligibility</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="survivorsPensionEligibility" name="Survivor&#39;s Pension Eligibility" calledElement="survPensionEligibility">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>survivorsPensionEligibilityInput</bpmn:incoming>
      <bpmn:outgoing>survivorsPensionEligibilityOutflow</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="evalDICEligibility" name="DIC Eligibility" calledElement="dicEligibility">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>dicEligibilityInput</bpmn:incoming>
      <bpmn:outgoing>dicEligibilityOutflow</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:businessRuleTask id="validateForm527Activity" name="Validate Form 527/527EZ" camunda:delegateExpression="${form527Validation}">
      <bpmn:incoming>flowToIpEligibility</bpmn:incoming>
      <bpmn:outgoing>Flow_1ohcqb0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:callActivity id="evalVeteransPensionEligibility" name="Veterans Pension Eligibility" calledElement="vetPensionEligibility">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ohcqb0</bpmn:incoming>
      <bpmn:outgoing>flowFromIpEligibility</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="deathBenefitParallelGatewayStart">
      <bpmn:incoming>continueFlowToParallel</bpmn:incoming>
      <bpmn:outgoing>dicEligibilityInput</bpmn:outgoing>
      <bpmn:outgoing>survivorsPensionEligibilityInput</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Activity_1mu25hq" name="Create Missing Child Dependents" camunda:delegateExpression="${createChildDependentsDelegate}">
      <bpmn:incoming>formValidationToParallelEligibilityGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_1tfqauo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="validateForm534Activity" name="Validate Form 534/534EZ" camunda:delegateExpression="${form534Validation}">
      <bpmn:incoming>routeByBenefitTypeDicFlow</bpmn:incoming>
      <bpmn:outgoing>formValidationToParallelEligibilityGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:callActivity id="evalContinAwardEligibility" name="Continuation of Award Eligibility" calledElement="continOfAwardEligibility">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
      </bpmn:extensionElements>
      <bpmn:incoming>flowToContinuationOfAwardEligibility</bpmn:incoming>
      <bpmn:outgoing>Flow_1k12drg</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="gatewayToCheckDICAwardStatus" name="DIC Award Status" default="Flow_1b1pc4f">
      <bpmn:incoming>Flow_0fc3mx1</bpmn:incoming>
      <bpmn:outgoing>flowToContinuationOfAwardEligibility</bpmn:outgoing>
      <bpmn:outgoing>flowToTerminatedDICEligibility</bpmn:outgoing>
      <bpmn:outgoing>Flow_1b1pc4f</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="evalTerminationDicElig" name="Terminated DIC Eligibility" calledElement="terminDicEligibility">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>flowToTerminatedDICEligibility</bpmn:incoming>
      <bpmn:outgoing>Flow_0u9p1na</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="joinDICAwardStatus">
      <bpmn:incoming>Flow_0u9p1na</bpmn:incoming>
      <bpmn:incoming>Flow_1k12drg</bpmn:incoming>
      <bpmn:outgoing>Flow_1w8zgdl</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gateway_RouteByBurialEligibilityType" name="Type of Burial Claim" default="notViaDic">
      <bpmn:incoming>routeByBenefitTypeBurialFlow</bpmn:incoming>
      <bpmn:outgoing>notViaDic</bpmn:outgoing>
      <bpmn:outgoing>flowToAutoBurialEligibility</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="evalBurialEligibility" name="Burial Eligibility" calledElement="burialEligibility">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17an1kc</bpmn:incoming>
      <bpmn:outgoing>burialEligibilityOutflow</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:businessRuleTask id="validateForm530Activity" name="Validate Form 530" camunda:delegateExpression="${form530Validation}">
      <bpmn:incoming>notViaDic</bpmn:incoming>
      <bpmn:outgoing>Flow_17an1kc</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:callActivity id="evalAutoBurialEligibility" name="Auto Burial Eligibility" calledElement="autoBurialEligibility">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>flowToAutoBurialEligibility</bpmn:incoming>
      <bpmn:outgoing>autoBurialEligibilityOutflow</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="autoBurialEligibilityOutflow" sourceRef="evalAutoBurialEligibility" targetRef="idevEndEvent" />
    <bpmn:sequenceFlow id="joinRouteByBenefitTypeOutflow" sourceRef="joinRouteByBenefitType" targetRef="idevEndEvent" />
    <bpmn:sequenceFlow id="Flow_1w8zgdl" sourceRef="joinDICAwardStatus" targetRef="idevEndEvent" />
    <bpmn:sequenceFlow id="routeByBenefitTypeDefaultFlow" sourceRef="gatewayRouteByBenefitType" targetRef="joinRouteByBenefitType" />
    <bpmn:sequenceFlow id="burialEligibilityOutflow" sourceRef="evalBurialEligibility" targetRef="joinRouteByBenefitType" />
    <bpmn:sequenceFlow id="flowFromIpEligibility" sourceRef="evalVeteransPensionEligibility" targetRef="joinRouteByBenefitType" />
    <bpmn:sequenceFlow id="deathBenefitCompleteFlow" sourceRef="evalDeathBenefitResults" targetRef="joinRouteByBenefitType" />
    <bpmn:sequenceFlow id="parallelExecutionToResultEvaluation" sourceRef="deathBenefitParallelGatewayEnd" targetRef="evalDeathBenefitResults" />
    <bpmn:sequenceFlow id="dicEligibilityOutflow" sourceRef="evalDICEligibility" targetRef="deathBenefitParallelGatewayEnd" />
    <bpmn:sequenceFlow id="survivorsPensionEligibilityOutflow" sourceRef="survivorsPensionEligibility" targetRef="deathBenefitParallelGatewayEnd" />
    <bpmn:sequenceFlow id="routeByBenefitTypeBurialFlow" name="Burial" sourceRef="gatewayRouteByBenefitType" targetRef="gateway_RouteByBurialEligibilityType">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${claimExecution.benefitType == "SCBB" || claimExecution.benefitType == "NSCBB"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="routeByBenefitTypeDicFlow" name="Death Benefits (DIC and Pension)" sourceRef="gatewayRouteByBenefitType" targetRef="validateForm534Activity">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${claimExecution.benefitType == "DIC" || claimExecution.benefitType == "IDP"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowToIpEligibility" name="IP-Improved Pension" sourceRef="gatewayRouteByBenefitType" targetRef="validateForm527Activity">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${claimExecution.benefitType == "IP"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="survivorsPensionEligibilityInput" sourceRef="deathBenefitParallelGatewayStart" targetRef="survivorsPensionEligibility" />
    <bpmn:sequenceFlow id="dicEligibilityInput" sourceRef="deathBenefitParallelGatewayStart" targetRef="evalDICEligibility" />
    <bpmn:sequenceFlow id="Flow_1ohcqb0" sourceRef="validateForm527Activity" targetRef="evalVeteransPensionEligibility" />
    <bpmn:sequenceFlow id="Flow_1tfqauo" sourceRef="Activity_1mu25hq" targetRef="Activity_0umdqbt" />
    <bpmn:sequenceFlow id="Flow_0fc3mx1" sourceRef="Activity_0umdqbt" targetRef="gatewayToCheckDICAwardStatus" />
    <bpmn:sequenceFlow id="formValidationToParallelEligibilityGateway" sourceRef="validateForm534Activity" targetRef="Activity_1mu25hq" />
    <bpmn:sequenceFlow id="flowToContinuationOfAwardEligibility" name="Has Running DIC Award?" sourceRef="gatewayToCheckDICAwardStatus" targetRef="evalContinAwardEligibility">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${awards_hasRunningDicAward}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1k12drg" sourceRef="evalContinAwardEligibility" targetRef="joinDICAwardStatus" />
    <bpmn:sequenceFlow id="flowToTerminatedDICEligibility" name="Has Terminated DIC Award?" sourceRef="gatewayToCheckDICAwardStatus" targetRef="evalTerminationDicElig">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${awards_terminatedDicAward}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0u9p1na" sourceRef="evalTerminationDicElig" targetRef="joinDICAwardStatus" />
    <bpmn:sequenceFlow id="flowToAutoBurialEligibility" name="Auto Burial Via DIC" sourceRef="gateway_RouteByBurialEligibilityType" targetRef="evalAutoBurialEligibility">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${claimCreatedByDicProcess || claimFromAutoBurialIntake}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="notViaDic" name="Burial Claim Filed" sourceRef="gateway_RouteByBurialEligibilityType" targetRef="validateForm530Activity" />
    <bpmn:sequenceFlow id="Flow_17an1kc" sourceRef="validateForm530Activity" targetRef="evalBurialEligibility" />
    <bpmn:subProcess id="errorEligibilitySubProcess" name="Handle Errors" triggeredByEvent="true">
      <bpmn:serviceTask id="eligibilityOfframpClaim" name="Offramp Claim" camunda:delegateExpression="${offrampClaimDelegate}">
        <bpmn:incoming>Flow_0p0ioxm</bpmn:incoming>
        <bpmn:outgoing>Flow_0copefy</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_0copefy" sourceRef="eligibilityOfframpClaim" targetRef="eligibilityEndEvent" />
      <bpmn:startEvent id="eligibilityErrorCaught" name="Error Caught">
        <bpmn:outgoing>Flow_0p0ioxm</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_02nhqu5" camunda:errorCodeVariable="errorCode" camunda:errorMessageVariable="errorMessage" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_0p0ioxm" sourceRef="eligibilityErrorCaught" targetRef="eligibilityOfframpClaim" />
      <bpmn:endEvent id="eligibilityEndEvent" name="Alert Process Intake to Stop">
        <bpmn:incoming>Flow_0copefy</bpmn:incoming>
        <bpmn:escalationEventDefinition id="EscalationEventDefinition_04dle4q" escalationRef="Escalation_1im19mq" />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:callActivity id="Activity_0umdqbt" name="Determine Event and Effective Date" calledElement="determineEventDateProcess">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1tfqauo</bpmn:incoming>
      <bpmn:outgoing>Flow_0fc3mx1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="continueFlowToParallel" sourceRef="Activity_1j000yx" targetRef="deathBenefitParallelGatewayStart" />
    <bpmn:sequenceFlow id="Flow_1b1pc4f" sourceRef="gatewayToCheckDICAwardStatus" targetRef="Activity_1j000yx" />
    <bpmn:callActivity id="Activity_1j000yx" name="PACT Act Eligibility" calledElement="pactActEligibilityProcess">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1b1pc4f</bpmn:incoming>
      <bpmn:outgoing>continueFlowToParallel</bpmn:outgoing>
    </bpmn:callActivity>
  </bpmn:process>
  <bpmn:error id="Error_0y5zf8k" name="UnsupportedBenefitType" errorCode="007" />
  <bpmn:process id="determineEventDateProcess" isExecutable="true">
    <bpmn:sequenceFlow id="Flow_1b1lig8" sourceRef="Event_1bfwivb" targetRef="Activity_1y4bvpr" />
    <bpmn:sequenceFlow id="Flow_0im6a8n" sourceRef="Activity_1y4bvpr" targetRef="Activity_0n3qoa3" />
    <bpmn:sequenceFlow id="Flow_0jowfqf" sourceRef="Activity_0n3qoa3" targetRef="Activity_1v90hc8" />
    <bpmn:sequenceFlow id="Flow_1lgl6sw" sourceRef="Activity_1v90hc8" targetRef="Gateway_050uuln" />
    <bpmn:sequenceFlow id="Flow_0a490rb" name="Yes" sourceRef="Gateway_050uuln" targetRef="Event_0zspk72" />
    <bpmn:sequenceFlow id="Flow_004jj2y" name="No" sourceRef="Gateway_050uuln" targetRef="Event_0ljjsva">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${eligibility_eligibilityDates == null || eligibility_eligibilityDates.get("dicEventDate") == null || eligibility_eligibilityDates.get("dicEffectiveDate") == null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0ljjsva" name="Offramp">
      <bpmn:incoming>Flow_004jj2y</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0v0pazd" errorRef="Error_0088lod" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_050uuln" name="Data Exists to Calculate Effective Date?" default="Flow_0a490rb">
      <bpmn:incoming>Flow_1lgl6sw</bpmn:incoming>
      <bpmn:outgoing>Flow_0a490rb</bpmn:outgoing>
      <bpmn:outgoing>Flow_004jj2y</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_0zspk72" name="End Event Date">
      <bpmn:incoming>Flow_0a490rb</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_0n3qoa3" name="Normalize Dates" camunda:delegateExpression="${dicDateNormalizer}">
      <bpmn:incoming>Flow_0im6a8n</bpmn:incoming>
      <bpmn:outgoing>Flow_0jowfqf</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Activity_1v90hc8" name="Determine Event and Effective Dates" camunda:resultVariable="eligibility_eligibilityDates" camunda:decisionRef="dicEventDateTable" camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>Flow_0jowfqf</bpmn:incoming>
      <bpmn:outgoing>Flow_1lgl6sw</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:startEvent id="Event_1bfwivb" name="Determine Event Date">
      <bpmn:outgoing>Flow_1b1lig8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_1y4bvpr" name="Populate ITF Date" camunda:delegateExpression="${populateIntentToFileDate}">
      <bpmn:incoming>Flow_1b1lig8</bpmn:incoming>
      <bpmn:outgoing>Flow_0im6a8n</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmn:error id="Error_0088lod" name="MissingDataForDICEffectiveDate" errorCode="222" camunda:errorMessage="Unable to determine DIC Effective Date due to missing data." />
  <bpmn:escalation id="Escalation_1im19mq" name="eligibilityEscalation" escalationCode="eligibilityEscalation" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="eligibilityCollaboration">
      <bpmndi:BPMNShape id="Participant_0jijj67_di" bpmnElement="eligibility" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1810" height="1290" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="eligibilityStartEvent">
        <dc:Bounds x="192" y="392" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="177" y="435" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_1ju62kk_di" bpmnElement="idevEndEvent">
        <dc:Bounds x="1544" y="392" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1590" y="403" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_13uk4dz_di" bpmnElement="joinRouteByBenefitType" isMarkerVisible="true">
        <dc:Bounds x="1465" y="385" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1d6debi_di" bpmnElement="evalDeathBenefitResults">
        <dc:Bounds x="1440" y="610" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_13b2jen_di" bpmnElement="deathBenefitParallelGatewayEnd">
        <dc:Bounds x="1375" y="725" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_0ut5jgo_di" bpmnElement="gatewayRouteByBenefitType" isMarkerVisible="true">
        <dc:Bounds x="515" y="385" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="448" y="376" width="83" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_06zvy23_di" bpmnElement="survivorsPensionEligibility">
        <dc:Bounds x="1230" y="810" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_14udv1i_di" bpmnElement="evalDICEligibility">
        <dc:Bounds x="1230" y="610" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0ozm0ow_di" bpmnElement="validateForm527Activity">
        <dc:Bounds x="600" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1xio20h_di" bpmnElement="evalVeteransPensionEligibility">
        <dc:Bounds x="1230" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_13e30a0_di" bpmnElement="deathBenefitParallelGatewayStart">
        <dc:Bounds x="1135" y="725" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1l4ir5s_di" bpmnElement="Activity_1mu25hq">
        <dc:Bounds x="750" y="710" width="100" height="80" />
      </bpmndi:BPMNShape>
