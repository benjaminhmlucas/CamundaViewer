<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="intakeEvaluateSupplementalDefinitions" name="Intake Evaluate Supplemental Definitions" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.29.0">
  <decision id="intake-evaluate-supplemental" name="Intake Evaluate Supplemental Data">
    <decisionTable id="decisionTable_1" hitPolicy="FIRST">
      <input id="InputClause_0ve28g1" label="Ep Code">
        <inputExpression id="LiteralExpression_1afsrbu" typeRef="integer" expressionLanguage="feel">
          <text>claimData.getEndProductCode()</text>
        </inputExpression>
      </input>
      <input id="InputClause_0ef2fvd" label="Claim Created By DIC Process">
        <inputExpression id="LiteralExpression_0hordwf" typeRef="boolean">
          <text>claimCreatedByDicProcess</text>
        </inputExpression>
      </input>
      <input id="InputClause_0wth3qi" label="Claim from Auto Burial Intake">
        <inputExpression id="LiteralExpression_1mawhdr" typeRef="boolean">
          <text>claimFromAutoBurialIntake != null and claimFromAutoBurialIntake</text>
        </inputExpression>
      </input>
      <input id="input_1" label="Form 530 Present">
        <inputExpression id="inputExpression_1" typeRef="boolean">
          <text>claimExecution.getBenefitsProcessingData.getForm530GroupData != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_0hgg4xq" label="Form 530 Failed to Parse">
        <inputExpression id="LiteralExpression_14zpgnz" typeRef="boolean">
          <text>if claimExecution.getBenefitsProcessingData.getForm530GroupData != null then claimExecution.getBenefitsProcessingData.getForm530GroupData.getFailedToParse else null</text>
        </inputExpression>
      </input>
      <input id="InputClause_1h115m8" label="Form 534EZ or Form 534 present">
        <inputExpression id="LiteralExpression_1yx9rkh" typeRef="boolean">
          <text>claimExecution.getBenefitsProcessingData.getForm534GroupData != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_174hl8t" label="Form 534 group Failed to Parse">
        <inputExpression id="LiteralExpression_0pjtcrj" typeRef="boolean">
          <text>if claimExecution.getBenefitsProcessingData.getForm534GroupData != null then claimExecution.getBenefitsProcessingData.getForm534GroupData.getFailedToParse else null</text>
        </inputExpression>
      </input>
      <input id="InputClause_0hdwcm8" label="Form 527 or 527EZ Present">
        <inputExpression id="LiteralExpression_1phg3c0" typeRef="boolean">
          <text>claimExecution.getBenefitsProcessingData.getForm527GroupData != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_0iwv3fc" label="Form 527 group Failed to Parse">
        <inputExpression id="LiteralExpression_06ei0km" typeRef="boolean">
          <text>if claimExecution.getBenefitsProcessingData.getForm527GroupData != null then claimExecution.getBenefitsProcessingData.getForm527GroupData.getFailedToParse else null</text>
        </inputExpression>
      </input>
      <input id="InputClause_1qcs19z" label="Veteran Date of Death Present">
        <inputExpression id="LiteralExpression_180tc7z" typeRef="boolean">
          <text>veteranInfo.getDateOfDeath != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_157sz0u" label="Development Claim with Homicide Manner of Death">
        <inputExpression id="LiteralExpression_1r976zu" typeRef="boolean" expressionLanguage="groovy">
          <text>import gov.va.bip.pensionautomation.model.bpds.domain.common.MannerOfDeath
import gov.va.bip.pensionautomation.model.claim.ClaimLifeCyclePhase

claimExecution.benefitsProcessingData != null &amp;&amp;
claimExecution.benefitsProcessingData.getDeathCertData() != null &amp;&amp; MannerOfDeath.HOMICIDE.equals(claimExecution.benefitsProcessingData.getDeathCertData().getMannerOfDeath()) &amp;&amp; ClaimLifeCyclePhase.DEVELOPMENT.equals(claimExecution.getClaimLifecycle())</text>
        </inputExpression>
      </input>
      <input id="InputClause_011r2fg" label="Cause and/or Manner of Death Review Offramp Flag">
        <inputExpression id="LiteralExpression_0261621" typeRef="boolean" expressionLanguage="groovy">
          <text>featureFlags.contains("cod-or-mod-review-offramp-flag")</text>
        </inputExpression>
      </input>
      <output id="output_1" label="Supplemental Data Complete" name="supplementalDataComplete" typeRef="boolean" />
      <output id="OutputClause_1jjhfl3" label="Error Code" name="evalSupp_errorCode" typeRef="string" />
