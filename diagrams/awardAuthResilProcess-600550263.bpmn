<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_0k5cr14" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="4.6.0">
  <bpmn:message id="Message_0v7o201" name="InvalidClaimType" />
  <bpmn:error id="Error_1wdb96h" name="IneligibleForAuthorize" errorCode="USE_MESSAGE" camunda:errorMessage="${authorizeErrorCode}" />
  <bpmn:collaboration id="awardsCollaboration">
    <bpmn:participant id="mainAwardsProcess" name="Main" processRef="awardProcess" />
    <bpmn:participant id="resilienceAwardAuthorization" name="Award Authorization with Resilience" processRef="awardAuthResilProcess" />
    <bpmn:participant id="defaultAwardAuthorization" name="Default Award Authorization" processRef="awardAuthorizationDefaultProcess" />
  </bpmn:collaboration>
  <bpmn:process id="awardProcess" name="Award Process" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property />
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:exclusiveGateway id="awardExistsGateway" name="Award Already Exists?">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${saveInitialAwardResultListener}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>initialChecksPassed</bpmn:incoming>
      <bpmn:outgoing>awardDoesNotExistSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>awardExistsSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="awardsPreCheck" name="Check Claim Validity" camunda:resultVariable="precheckErrorCode" camunda:decisionRef="awardsPreCheck" camunda:mapDecisionResult="singleEntry">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${validContentionCheck}" event="start" />
        <camunda:executionListener delegateExpression="${invalidAwardCheck}" event="start" />
        <camunda:executionListener delegateExpression="${veteranDeathDateBefore1993Check}" event="start" />
        <camunda:executionListener delegateExpression="${minorChildCheck}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1yt5bjp</bpmn:incoming>
      <bpmn:outgoing>awardsPreCheckOutput</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="validClaimGateway" name="Claim is Valid for Automation?" default="initialChecksPassed">
      <bpmn:incoming>awardsPreCheckOutput</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0485d6x</bpmn:outgoing>
      <bpmn:outgoing>initialChecksPassed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="invalidClaimErrorEvent">
      <bpmn:incoming>SequenceFlow_0485d6x</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1hl5r5p" errorRef="Error_0zkbndu" />
    </bpmn:endEvent>
    <bpmn:sendTask id="createAwardTask" name="Create Award" camunda:delegateExpression="${createAward}">
      <bpmn:incoming>awardDoesNotExistSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>createAwardOutput</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:startEvent id="awardsMessageStart" name="Start via Message" camunda:asyncAfter="true">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;awards_newDecisionsAdded&#39;, false)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1yt5bjp</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1sswfrr" messageRef="Message_1581apd" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1yt5bjp" sourceRef="awardsMessageStart" targetRef="awardsPreCheck" />
    <bpmn:sequenceFlow id="awardDoesNotExistSequenceFlow" name="No" sourceRef="awardExistsGateway" targetRef="createAwardTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${awards_currentAward == null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="initialChecksPassed" name="Yes" sourceRef="validClaimGateway" targetRef="awardExistsGateway" />
    <bpmn:sequenceFlow id="SequenceFlow_0485d6x" name="No" sourceRef="validClaimGateway" targetRef="invalidClaimErrorEvent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${not(precheckErrorCode == null)}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="awardsPreCheckOutput" sourceRef="awardsPreCheck" targetRef="validClaimGateway" />
    <bpmn:sequenceFlow id="awardExistsSequenceFlow" name="Yes" sourceRef="awardExistsGateway" targetRef="Gateway_1pkoi2r">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${not(awards_currentAward == null)}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="createAwardOutput" sourceRef="createAwardTask" targetRef="awardSuspensionGateway" />
    <bpmn:exclusiveGateway id="awardTypeGateway" name="Award Type">
      <bpmn:incoming>Flow_03kjm5a</bpmn:incoming>
      <bpmn:outgoing>burialSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>cplSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>dicSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="callBurialAwardDecisions" name="Add Burial Decisions" calledElement="burialAwardDecisions">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
      </bpmn:extensionElements>
      <bpmn:incoming>burialSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>flowFromAddBurialDecisionsToAwardPendingAuthCheck</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="callDICAwardDecisions" name="Add CPD Decisions" calledElement="dicAwardDecisions">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
      </bpmn:extensionElements>
      <bpmn:incoming>dicSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>flowFromAddDicDecisionsToAwardPendingAuthCheck</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="awardStatusCheck" name="Award Pending Authorization?" default="existingAwardNotPendingAuthorization">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${checkForDecisionsAdded}" event="start" />
        <camunda:executionListener delegateExpression="${saveAwardDecisionListener}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>flowFromAddDicDecisionsToAwardPendingAuthCheck</bpmn:incoming>
      <bpmn:incoming>flowFromAddCplDecisionsToAwardPendingAuthCheck</bpmn:incoming>
      <bpmn:incoming>flowFromAddBurialDecisionsToAwardPendingAuthCheck</bpmn:incoming>
      <bpmn:outgoing>existingAwardNotPendingAuthorization</bpmn:outgoing>
      <bpmn:outgoing>existingAwardPendingAuthorization</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="generateAward" name="Generate Award" camunda:delegateExpression="${generateAward}">
      <bpmn:incoming>existingAwardNotPendingAuthorization</bpmn:incoming>
      <bpmn:incoming>noChangePendingAuthorizationGateway_No</bpmn:incoming>
      <bpmn:outgoing>Flow_1ltp9ae</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:businessRuleTask id="determineAuthorizeTask" name="Can we authorize?" camunda:resultVariable="authorizeErrorCode" camunda:decisionRef="authorizationDmn" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_1ltp9ae</bpmn:incoming>
      <bpmn:incoming>existingAwardPendingAuthorization</bpmn:incoming>
      <bpmn:incoming>noChangePendingAuthorizationContinue</bpmn:incoming>
      <bpmn:outgoing>authorizationDecisionOutput</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="authorizationDecisionGateway">
      <bpmn:incoming>authorizationDecisionOutput</bpmn:incoming>
      <bpmn:outgoing>notEligibileForAuthorization</bpmn:outgoing>
      <bpmn:outgoing>Flow_02m8tvg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ineligibleForAuthorizeErrorEvent">
      <bpmn:incoming>notEligibileForAuthorization</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1iorj59" errorRef="Error_1wdb96h" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="cplSequenceFlow" name="CPL" sourceRef="awardTypeGateway" targetRef="addCplDecisionsTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${claimExecution.awardType.code=="CPL"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="burialSequenceFlow" name="Burial" sourceRef="awardTypeGateway" targetRef="callBurialAwardDecisions">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${claimExecution.awardType.code=="BUR"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="dicSequenceFlow" name="CPD" sourceRef="awardTypeGateway" targetRef="callDICAwardDecisions">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${claimExecution.awardType.code=="CPDS" || claimExecution.awardType.code=="CPDC" || claimExecution.awardType.code=="CPDP"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowFromAddBurialDecisionsToAwardPendingAuthCheck" sourceRef="callBurialAwardDecisions" targetRef="awardStatusCheck" />
    <bpmn:sequenceFlow id="flowFromAddDicDecisionsToAwardPendingAuthCheck" sourceRef="callDICAwardDecisions" targetRef="awardStatusCheck" />
    <bpmn:sequenceFlow id="flowFromAddCplDecisionsToAwardPendingAuthCheck" sourceRef="addCplDecisionsTask" targetRef="awardStatusCheck" />
    <bpmn:sequenceFlow id="existingAwardPendingAuthorization" name="Yes" sourceRef="awardStatusCheck" targetRef="determineAuthorizeTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${awards_currentAward.awardStatus eq "GENERATED" || awards_currentAward.awardStatus eq "PENDING_CONCUR"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="existingAwardNotPendingAuthorization" name="No" sourceRef="awardStatusCheck" targetRef="generateAward" />
    <bpmn:sequenceFlow id="Flow_1ltp9ae" sourceRef="generateAward" targetRef="determineAuthorizeTask" />
    <bpmn:sequenceFlow id="authorizationDecisionOutput" sourceRef="determineAuthorizeTask" targetRef="authorizationDecisionGateway" />
    <bpmn:sequenceFlow id="notEligibileForAuthorization" name="Not Eligibile for Authorize" sourceRef="authorizationDecisionGateway" targetRef="ineligibleForAuthorizeErrorEvent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${not(authorizeErrorCode == null)}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0s6du3z" name="Yes" sourceRef="awardSuspensionGateway" targetRef="gatewaySuspendResilEnabled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${awards_suspendAward}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="awardSuspensionGateway" name="Do We Need to Suspend the Award?" default="Flow_03kjm5a">
      <bpmn:incoming>createAwardOutput</bpmn:incoming>
      <bpmn:incoming>updateTheAward_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_0s6du3z</bpmn:outgoing>
      <bpmn:outgoing>Flow_03kjm5a</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_03kjm5a" name="No" sourceRef="awardSuspensionGateway" targetRef="awardTypeGateway" />
    <bpmn:sequenceFlow id="updateTheAward_Yes" name="Yes" sourceRef="Gateway_1pkoi2r" targetRef="awardSuspensionGateway" />
    <bpmn:exclusiveGateway id="Gateway_1pkoi2r" name="Do We Need to Update the Award?&#10;&#10;" default="updateTheAward_Yes">
      <bpmn:incoming>awardExistsSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>updateTheAward_Yes</bpmn:outgoing>
      <bpmn:outgoing>updateTheAward_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="updateTheAward_No" name="No&#10;&#10;" sourceRef="Gateway_1pkoi2r" targetRef="noChangePendingAuthorizationGateway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="groovy">import gov.va.bip.pensionautomation.engine.eligibility.AwardEligibilityBenefitType;

claimExecution.getAwardResults(AwardEligibilityBenefitType.DIC) != null &amp;&amp; claimExecution.getAwardResults(AwardEligibilityBenefitType.DIC).every { it.getDesignation().toString() == "NO_CHANGE" }</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="noChangePendingAuthorizationGateway" name="Award Pending Authorization?" default="noChangePendingAuthorizationGateway_No">
      <bpmn:incoming>updateTheAward_No</bpmn:incoming>
      <bpmn:outgoing>noChangePendingAuthorizationGateway_Yes</bpmn:outgoing>
      <bpmn:outgoing>noChangePendingAuthorizationGateway_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="noChangePendingAuthorizationGateway_Yes" name="Yes&#10;&#10;" sourceRef="noChangePendingAuthorizationGateway" targetRef="changesToAwardDecisionsGateway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${awards_currentAward.awardStatus eq "GENERATED" || awards_currentAward.awardStatus eq "PENDING_CONCUR"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="noChangePendingAuthorizationGateway_No" name="No" sourceRef="noChangePendingAuthorizationGateway" targetRef="generateAward" />
    <bpmn:callActivity id="addCplDecisionsTask" name="Add CPL Decisions" calledElement="cplAwardDecisions">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>cplSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>flowFromAddCplDecisionsToAwardPendingAuthCheck</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="noChangeAlreadyPendingAuthorizationErrorEvent">
      <bpmn:incoming>noChangeButAwardChangesExist</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0bgq0ct" errorRef="Error_02553af" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="changesToAwardDecisionsGateway" name="Change to Award Decisions?" default="noChangePendingAuthorizationContinue">
      <bpmn:incoming>noChangePendingAuthorizationGateway_Yes</bpmn:incoming>
      <bpmn:outgoing>noChangeButAwardChangesExist</bpmn:outgoing>
      <bpmn:outgoing>noChangePendingAuthorizationContinue</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="noChangeButAwardChangesExist" name="Yes" sourceRef="changesToAwardDecisionsGateway" targetRef="noChangeAlreadyPendingAuthorizationErrorEvent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="groovy">awards_currentAward.getAllDecisions().any{!it.isPreviouslyAuthorized()}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="noChangePendingAuthorizationContinue" name="No" sourceRef="changesToAwardDecisionsGateway" targetRef="determineAuthorizeTask" />
    <bpmn:subProcess id="Activity_1vcu63h" name="Handle Errors" triggeredByEvent="true">
      <bpmn:serviceTask id="Activity_0r3dm9p" name="Offramp Claim" camunda:delegateExpression="${offrampClaimDelegate}">
        <bpmn:incoming>Flow_02nauha</bpmn:incoming>
        <bpmn:outgoing>Flow_1nkdehs</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:startEvent id="Event_1ab4uwo" name="Error Caught">
        <bpmn:outgoing>Flow_02nauha</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_1lw6nyl" camunda:errorCodeVariable="errorCode" camunda:errorMessageVariable="errorMessage" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_02nauha" sourceRef="Event_1ab4uwo" targetRef="Activity_0r3dm9p" />
      <bpmn:sequenceFlow id="Flow_1nkdehs" sourceRef="Activity_0r3dm9p" targetRef="documentUploadEndEvent" />
      <bpmn:endEvent id="documentUploadEndEvent" name="Document Upload">
        <bpmn:incoming>Flow_1nkdehs</bpmn:incoming>
        <bpmn:messageEventDefinition id="MessageEventDefinition_1f0t02o" camunda:delegateExpression="${callDocumentUpload}" />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_02m8tvg" name="Eligible for Authorize" sourceRef="authorizationDecisionGateway" targetRef="callVetRecordViaAwards">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${authorizeErrorCode == null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09am12q" name="No" sourceRef="gatewaySuspendResilEnabled" targetRef="suspendAwardDefault" />
    <bpmn:sequenceFlow id="Flow_144cd6g" name="Yes" sourceRef="gatewaySuspendResilEnabled" targetRef="suspendAwardResil">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${correspondenceResilience}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="gatewaySuspendResilEnabled" name="Correspondence Resilience Enabled?" default="Flow_09am12q">
      <bpmn:incoming>Flow_0s6du3z</bpmn:incoming>
      <bpmn:outgoing>Flow_09am12q</bpmn:outgoing>
      <bpmn:outgoing>Flow_144cd6g</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="suspendAwardResil" name="Suspend Award (Resilience)" calledElement="suspendAwardProcessResil">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_144cd6g</bpmn:incoming>
    </bpmn:callActivity>
    <bpmn:callActivity id="suspendAwardDefault" name="Suspend Award (Default)" calledElement="suspendAwardProcessDefault">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09am12q</bpmn:incoming>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_0a7wpf6" name="Correspondence Resilience Enabled?" default="Flow_1y9ecfj">
      <bpmn:incoming>Flow_01yrvng</bpmn:incoming>
      <bpmn:outgoing>Flow_1976rx5</bpmn:outgoing>
      <bpmn:outgoing>Flow_1y9ecfj</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Activity_0ag0zbd" name="Authorize Award (Default)" calledElement="awardAuthorizationDefaultProcess">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1y9ecfj</bpmn:incoming>
      <bpmn:outgoing>Flow_0pf1g7y</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="isClaimBeingAwardedDICGateway" name="Is Claim Being Awarded DIC?" camunda:asyncBefore="true" default="Flow_1jeqbik">
      <bpmn:incoming>Flow_1w9m0f0</bpmn:incoming>
      <bpmn:incoming>Flow_0pf1g7y</bpmn:incoming>
      <bpmn:outgoing>Flow_1jeqbik</bpmn:outgoing>
      <bpmn:outgoing>Flow_0qtpi1n</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Activity_0d7x67h" name="Authorize Award (Resilience)" calledElement="awardAuthResilProcess">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1976rx5</bpmn:incoming>
      <bpmn:outgoing>Flow_1w9m0f0</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="awardProcessComplete" name="Award Process Completed">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${processCompleteListener}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18cz028</bpmn:incoming>
      <bpmn:incoming>Flow_1jeqbik</bpmn:incoming>
      <bpmn:incoming>Flow_1jyb254</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gatewayToEstablishAutoBurialClaim" name="Should Burial Claim Be Established?" default="Flow_18cz028">
      <bpmn:incoming>Flow_0kvddx6</bpmn:incoming>
      <bpmn:outgoing>Flow_166y0lh</bpmn:outgoing>
      <bpmn:outgoing>Flow_18cz028</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="createClaimProcessComplete" name="Create Auto Burial Claim" camunda:delegateExpression="${createAutoBurialClaimDelegate}">
      <bpmn:incoming>Flow_166y0lh</bpmn:incoming>
      <bpmn:outgoing>Flow_1wxdrc2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="startAutoBurialIntake" name="Start Auto Burial Claim Intake Process">
      <bpmn:incoming>Flow_1wxdrc2</bpmn:incoming>
      <bpmn:outgoing>Flow_1jyb254</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_19cyrvn" camunda:delegateExpression="${startAutoBurialIntake}" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="establishAutoBurialClaimCheck" name="Establish Auto Burial Claim Check" camunda:delegateExpression="${establishAutoBurialWhenDicGrantedCheck}">
      <bpmn:incoming>Flow_0qtpi1n</bpmn:incoming>
      <bpmn:outgoing>Flow_0kvddx6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1976rx5" name="Yes" sourceRef="Gateway_0a7wpf6" targetRef="Activity_0d7x67h">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${correspondenceResilience}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1y9ecfj" name="No" sourceRef="Gateway_0a7wpf6" targetRef="Activity_0ag0zbd" />
    <bpmn:sequenceFlow id="Flow_0pf1g7y" sourceRef="Activity_0ag0zbd" targetRef="isClaimBeingAwardedDICGateway" />
    <bpmn:sequenceFlow id="Flow_1w9m0f0" sourceRef="Activity_0d7x67h" targetRef="isClaimBeingAwardedDICGateway" />
    <bpmn:sequenceFlow id="Flow_1jeqbik" name="No" sourceRef="isClaimBeingAwardedDICGateway" targetRef="awardProcessComplete" />
    <bpmn:sequenceFlow id="Flow_0qtpi1n" name="Yes" sourceRef="isClaimBeingAwardedDICGateway" targetRef="establishAutoBurialClaimCheck">
