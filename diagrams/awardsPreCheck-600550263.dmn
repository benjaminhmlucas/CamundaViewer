<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Definitions_08sx7sk" name="DRD" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.19.0">
  <decision id="awardsPreCheck" name="Awards Pre-Check">
    <decisionTable id="decisionTable_1" hitPolicy="FIRST">
      <input id="InputClause_0xfk76y" label="Benefit Type">
        <inputExpression id="LiteralExpression_1t396b2" typeRef="string" expressionLanguage="juel">
          <text>claimExecution.benefitType.code</text>
        </inputExpression>
      </input>
      <input id="InputClause_0glp2n0" label="Claim Status">
        <inputExpression id="LiteralExpression_10dxhfp" typeRef="string" expressionLanguage="groovy">
          <text>claimExecution.claimStatus</text>
        </inputExpression>
      </input>
      <input id="InputClause_19jti4x" label="Veteran Has DOB">
        <inputExpression id="LiteralExpression_1ii441g" typeRef="boolean">
          <text>not(veteranInfo.dateOfBirth = null)</text>
        </inputExpression>
      </input>
      <input id="InputClause_1wyu6ea" label="Granting DIC">
        <inputExpression id="LiteralExpression_1sawhcm" typeRef="boolean" expressionLanguage="groovy">
          <text>awards_dicResult != null &amp;&amp; awards_dicResult.eligible &amp;&amp; awards_militaryDicResult != null &amp;&amp; awards_militaryDicResult.eligible</text>
        </inputExpression>
      </input>
      <input id="InputClause_1bla0a4" label="Valid Contentions">
        <inputExpression id="LiteralExpression_0fq55cv" typeRef="boolean">
          <text>awards_validContentions</text>
        </inputExpression>
      </input>
      <input id="InputClause_100pt12" label="Claimant &#10;Relationship">
        <inputExpression id="LiteralExpression_0929hw2" typeRef="string" expressionLanguage="groovy">
          <text>claimantPersonalInfoData?.relationship?.name</text>
        </inputExpression>
      </input>
      <input id="InputClause_0ozzutn" label=" Veteran SBP Amount &#10;Greater Than Zero">
        <inputExpression id="LiteralExpression_1oube3g" typeRef="boolean">
          <text>veteranInfo.dmdcRetirePaySbpAmtC &gt; 0</text>
        </inputExpression>
      </input>
      <input id="InputClause_1kqo5eb" label="Unterminated &#10;CPL Award">
        <inputExpression id="LiteralExpression_0t6a55q" typeRef="boolean" expressionLanguage="groovy">
          <text>awards_cplAward!=null &amp;&amp; awards_cplAward.awardStatus!=null &amp;&amp; awards_cplAward.awardEvents!=null &amp;&amp; awards_cplAward.awardEvents.any{it.awardStatus=="A"} &amp;&amp; awards_cplTerminationDate==null &amp;&amp; awards_cplAward.currentAwardEventType.code!="D"</text>
        </inputExpression>
      </input>
      <input id="InputClause_1762zwy" label="Claimant Has DOB">
        <inputExpression id="LiteralExpression_0d5hjxd" typeRef="boolean">
          <text>not(claimantPersonalInfoData.dateOfBirth = null)</text>
        </inputExpression>
      </input>
      <input id="InputClause_0l4olgv" label="HB and AA Flag">
        <inputExpression id="LiteralExpression_0jcp6w8" typeRef="boolean" expressionLanguage="groovy">
          <text>grantAaHbFlag</text>
        </inputExpression>
      </input>
      <input id="InputClause_0hxsfp4" label="Ancillary Decision">
        <inputExpression id="LiteralExpression_12sdmr7" typeRef="" expressionLanguage="groovy">
          <text>ratings_ratingProfile?.ancillaryDecisions.findAll { it.ptcpntDecnId == String.valueOf(claimantPersonalInfoData.participantId)}.collect { it.ancDecnTc }</text>
        </inputExpression>
      </input>
      <input id="InputClause_0nocpvc" label="SMP Decision">
        <inputExpression id="LiteralExpression_1ex9cpw" typeRef="" expressionLanguage="groovy">
          <text>ratings_ratingProfile?.smpDecisions.findAll { it.ptcpntDecnId == String.valueOf(claimantPersonalInfoData.participantId)}.collect { it.smpDecnTc }</text>
        </inputExpression>
      </input>
      <input id="InputClause_11y7y7j" label="Competency Decision">
        <inputExpression id="LiteralExpression_01hrbev" typeRef="" expressionLanguage="groovy">
          <text>ratings_ratingProfile?.competencyDecisions.findAll { it.ptcpntDecnId == String.valueOf(claimantPersonalInfoData.participantId)}.collect { it.cmptnyDecnTc }</text>
        </inputExpression>
      </input>
      <input id="InputClause_1od5yof" label="Enable 2680 Check">
        <inputExpression id="LiteralExpression_1pc0rem" typeRef="boolean">
          <text>enable2680Check</text>
        </inputExpression>
      </input>
      <input id="InputClause_19zkcyq" label="Valid 2680 Exists">
        <inputExpression id="LiteralExpression_12i1zkr" typeRef="boolean">
          <text>eligibility_valid2680Exists</text>
        </inputExpression>
      </input>
      <input id="InputClause_1htgqhz" label="Lifecycle Status">
        <inputExpression id="LiteralExpression_0oy88m2" typeRef="string">
          <text>claimData.getClaimLifecycleStatus</text>
        </inputExpression>
      </input>
      <input id="InputClause_0z4v99k" label="EnableCutoffForSpouseSBPOfframp">
        <inputExpression id="LiteralExpression_02ksxgc" typeRef="boolean">
          <text>enableCutoffForSpouseSBPOfframp and dateOfDeathCutoffForSpouseSBPOfframp != null</text>
        </inputExpression>
      </input>
      <input id="InputClause_0b4fj31" label="Veteran Date of Death">
        <inputExpression id="LiteralExpression_1ksv23p" typeRef="date" expressionLanguage="groovy">
          <text>if (veteranInfo.dateOfDeath){ java.time.LocalDateTime.of(veteranInfo.dateOfDeath, java.time.LocalTime.MIN) }</text>
        </inputExpression>
      </input>
      <input id="InputClause_01lss01" label="Has Running &#10;DIC Award">
        <inputExpression id="LiteralExpression_1w4zolj" typeRef="boolean">
          <text>awards_hasRunningDicAward</text>
        </inputExpression>
      </input>
      <input id="InputClause_12lj85t" label="SC Cause of Death or &#10;Entitlement Under 1318">
        <inputExpression id="LiteralExpression_1okt4h6" typeRef="boolean">
          <text>awards_scForCauseOfDeath or awards_scForEntitlementUnder1318</text>
        </inputExpression>
      </input>
      <input id="InputClause_077fwpk" label="Eligible Minor Child">
        <inputExpression id="LiteralExpression_1albgfq" typeRef="boolean" expressionLanguage="groovy">
          <text>awards_dependencyResult != null &amp;&amp; awards_dependencyResult.eligible &amp;&amp; awards_dependencyResult.childResults != null &amp;&amp; awards_dependencyResult.childResults.any{it.eligibilityReason.description=="Eligible Minor Child"}</text>
        </inputExpression>
      </input>
      <output id="output_1" label="Error Code" typeRef="string" />
