<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/DMN/20151101/dmn.xsd" id="Definitions_0dxm0sw" name="DRD" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="3.7.2">
  <decision id="scBurialEntitlement" name="SC Burial Entitlement">
    <decisionTable id="decisionTable_1">
      <input id="input_1" label="Date of Death">
        <inputExpression id="inputExpression_1" typeRef="date" expressionLanguage="groovy">
          <text>import java.time.ZoneId; java.util.Date.from(veteranInfo.getDateOfDeath().atStartOfDay().atZone(ZoneId.systemDefault()).toInstant());</text>
        </inputExpression>
      </input>
      <output id="output_1" label="Entitlement" name="scEntitlement" typeRef="double" />
      <rule id="DecisionRule_173jlfh">
        <inputEntry id="UnaryTests_15nnx9g">
          <text>&gt;= date and time("2001-09-11T00:00:00")</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1sde3sm">
          <text>2000.00 - eligibility_previousScBurialAmount</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0691d4m">
        <inputEntry id="UnaryTests_1ap5en0">
          <text>&lt; date and time("2001-09-11T00:00:00")</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_059c15t">
          <text>1500.00 - eligibility_previousScBurialAmount</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>

